Config:
	config ETHTOOL_NETLINK
		depends on PACKAGE_ethtool
		bool "Enable netlink interface"
		default y

	config ETHTOOL_PRETTY_DUMP
		depends on PACKAGE_ethtool
		bool "Enable pretty printing"
		default n
@@

