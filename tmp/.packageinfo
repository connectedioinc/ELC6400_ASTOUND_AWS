Build-Depends: lua/host luci-base/host LUCI_CSSTIDY:csstidy/host LUCI_SRCDIET:luasrcdiet/host 
Build-Types: host

Package: luci-base
Submenu: 2. Modules
Version: x
Depends: +libc +lua +luci-lib-nixio +luci-lib-ip +rpcd +libubus-lua +luci-lib-jsonc +liblucihttp-lua +luci-lib-base +rpcd-mod-file +rpcd-mod-luci +cgi-io
Conflicts: 
Menu-Depends: 
Provides: 
Section: luci
Category: LuCI
Repository: luci
Title: LuCI core libraries
Maintainer: OpenWrt LuCI community
Source: 
License: MIT
Type: ipkg
Detail-Description: LuCI core libraries
Description: LuCI core libraries
https://github.com/openwrt/luci
OpenWrt LuCI community
@@
Config:
   config LUCI_SRCDIET
	bool "Minify Lua sources"
	default n

   config LUCI_JSMIN
	bool "Minify JavaScript sources"
	default y

   config LUCI_CSSTIDY
        bool "Minify CSS files"
        default y

   menu "Translations"

     config LUCI_LANG_ar
	   tristate "Arabic (ar)" 

     config LUCI_LANG_bg
	   tristate "Bulgarian (bg)" 

     config LUCI_LANG_bn_BD
	   tristate "Bengali (bn_BD)" 

     config LUCI_LANG_ca
	   tristate "Catalan (ca)" 

     config LUCI_LANG_cs
	   tristate "Czech (cs)" 

     config LUCI_LANG_de
	   tristate "German (de)" 

     config LUCI_LANG_el
	   tristate "Greek (el)" 

     config LUCI_LANG_en
	   tristate "English (en)" 

     config LUCI_LANG_es
	   tristate "Spanish (es)" 

     config LUCI_LANG_fi
	   tristate "Finnish (fi)" 

     config LUCI_LANG_fr
	   tristate "French (fr)" 

     config LUCI_LANG_he
	   tristate "Hebrew (he)" 

     config LUCI_LANG_hi
	   tristate "Hindi (hi)" 

     config LUCI_LANG_hu
	   tristate "Hungarian (hu)" 

     config LUCI_LANG_it
	   tristate "Italian (it)" 

     config LUCI_LANG_ja
	   tristate "Japanese (ja)" 

     config LUCI_LANG_ko
	   tristate "Korean (ko)" 

     config LUCI_LANG_mr
	   tristate "Marathi (mr)" 

     config LUCI_LANG_ms
	   tristate "Malay (ms)" 

     config LUCI_LANG_nb_NO
	   tristate "Norwegian (nb_NO)" 

     config LUCI_LANG_nl
	   tristate "Dutch (nl)" 

     config LUCI_LANG_pl
	   tristate "Polish (pl)" 

     config LUCI_LANG_pt
	   tristate "Portuguese (pt)" 

     config LUCI_LANG_pt_BR
	   tristate "Brazilian Portuguese (pt_BR)" 

     config LUCI_LANG_ro
	   tristate "Romanian (ro)" 

     config LUCI_LANG_ru
	   tristate "Russian (ru)" 

     config LUCI_LANG_sk
	   tristate "Slovak (sk)" 

     config LUCI_LANG_sv
	   tristate "Swedish (sv)" 

     config LUCI_LANG_tr
	   tristate "Turkish (tr)" 

     config LUCI_LANG_uk
	   tristate "Ukrainian (uk)" 

     config LUCI_LANG_vi
	   tristate "Vietnamese (vi)" 

     config LUCI_LANG_zh_Hans
