Package: kmod-mac80211_66
Menu: 1
Submenu: Wireless Drivers
Version: <LINUX_VERSION>+6.12.6-1
Depends: +kmod-cfg80211_66 +kmod-crypto-cmac +kmod-crypto-ccm +kmod-crypto-gcm +hostapd-common
Conflicts: 
Menu-Depends: 
Provides: 
Section: kernel
Category: Kernel modules
Title: Linux 802.11 Wireless Networking Stack
Maintainer: Felix Fietkau <nbd@nbd.name>
Source: backports-6.12.6.tar.xz
License: GPL-2.0-only
LicenseFiles: COPYING
Type: ipkg
Kernel-Config: CONFIG_AVERAGE=y
Detail-Description: Linux 802.11 Wireless Networking Stack
Description: Generic IEEE 802.11 Networking Stack (mac80211)
https://wireless.wiki.kernel.org/
Felix Fietkau <nbd@nbd.name>
@@
Config:
  if PACKAGE_kmod-mac80211_66

	config PACKAGE_MAC80211_DEBUGFS
		bool "Export mac80211 internals in DebugFS"
		select KERNEL_DEBUG_FS
		default y
		help
		  Select this to see extensive information about
		  the internal state of mac80211 in debugfs.

	config PACKAGE_MAC80211_TRACING
		bool "Enable tracing (mac80211 and supported drivers)"
		select KERNEL_FTRACE
		select KERNEL_ENABLE_DEFAULT_TRACERS
		default n
		help
		  Select this to enable tracing of mac80211 and
		  related wifi drivers (using trace-cmd).

	config PACKAGE_MAC80211_MESH
		bool "Enable 802.11s mesh support"
		default y

  endif
@@


