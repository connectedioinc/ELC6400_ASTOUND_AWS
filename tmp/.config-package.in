		tristate "getrandom................................ OpenWrt getrandom system helper"
		default y if DEFAULT_getrandom
		default m if ALL
		select PACKAGE_libc
		help
		 OpenWrt getrandom system helper
		 John Crispin <john@phrozen.org>

