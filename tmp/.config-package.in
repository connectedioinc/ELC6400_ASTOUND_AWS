	config PACKAGE_kmod-rtc-ds1307
		tristate "kmod-rtc-ds1307......... Dallas/Maxim DS1307 (and compatible) RTC support"
		default y if DEFAULT_kmod-rtc-ds1307
		default m if ALL_KMODS && RTC_SUPPORT
		select PACKAGE_kmod-i2c-core
