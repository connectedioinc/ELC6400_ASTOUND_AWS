		select PACKAGE_kmod-qcom-qmi-helpers_66
		depends on PCI_SUPPORT||USB_SUPPORT||TARGET_ath79
		select DRIVER_11AX_SUPPORT
		select PACKAGE_kmod-crypto-michael-mic
		select PACKAGE_kmod-hwmon-core if ATH11K_THERMAL
