		default y if DEFAULT_kmod-at86rf230
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		select PACKAGE_kmod-regmap-spi
		select PACKAGE_kmod-mac802154
		help
		 AT86RF230 transceiver driver
		 

	config PACKAGE_kmod-atusb
