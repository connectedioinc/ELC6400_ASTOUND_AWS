menu "FreeRADIUS (version 3)"
	config PACKAGE_freeradius3
		tristate "freeradius3......................... A flexible RADIUS server (version 3)"
		default y if DEFAULT_freeradius3
		default m if ALL
		select PACKAGE_freeradius3-mod-eap-peap
		depends on FREERADIUS3_OPENSSL
		select PACKAGE_freeradius3-mod-radutmp
		select PACKAGE_freeradius3-mod-eap-ttls
		select PACKAGE_freeradius3-mod-pap
		select PACKAGE_freeradius3-mod-preprocess
		select PACKAGE_freeradius3-mod-detail
