		select PACKAGE_freeradius3-mod-files
		select PACKAGE_freeradius3-democerts
		select PACKAGE_libc
		select PACKAGE_freeradius3-mod-mschap
		help
		 One of the top open source RADIUS servers, can be used as an Authentication Server in 802.1X and therefore for WPA/WPA2/WPA3 Enterprise setup
		 https://freeradius.org/
		 


	  source "package/network/services/freeradius3/Config.in"

