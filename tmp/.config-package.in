		 http://www.strongswan.org/
		 Philip Prindeville <philipp@redfish-solutions.com>, Noel Kuntze <noel.kuntze@thermi.consulting>

	config PACKAGE_strongswan-swanctl
		tristate "strongswan-swanctl............................ StrongSwan swanctl utility"
		default y if DEFAULT_strongswan-swanctl
		default m if ALL
		depends on PACKAGE_strongswan
		select PACKAGE_strongswan-mod-vici
		select PACKAGE_libc
		help
		 StrongSwan is an OpenSource IPsec implementation for the Linux operating system.
		  This package contains the swanctl utility.
		 http://www.strongswan.org/
		 Philip Prindeville <philipp@redfish-solutions.com>, Noel Kuntze <noel.kuntze@thermi.consulting>

	config PACKAGE_strongswan-tss-tss2
		tristate "strongswan-tss-tss2.................................. StrongSwan TSS-TSS2"
		default y if DEFAULT_strongswan-tss-tss2
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_tpm2-tss
		depends on PACKAGE_strongswan
		help
		 strongswan tss2 lib for tpm support
		 http://www.strongswan.org/
		 Philip Prindeville <philipp@redfish-solutions.com>, Noel Kuntze <noel.kuntze@thermi.consulting>

	config PACKAGE_tailscale
		tristate "tailscale................................................ Zero config VPN"
		default y if DEFAULT_tailscale
		default m if ALL
		select PACKAGE_ca-bundle
		select PACKAGE_libc
		depends on (aarch64||arm||i386||i686||loongarch64||mips||mips64||mips64el||mipsel||powerpc64||riscv64||x86_64)
		select PACKAGE_kmod-tun
		help
		 It creates a secure network between your servers, computers,
		   and cloud instances. Even when separated by firewalls or subnets.
		 https://tailscale.com
		 Jan Pavlinec <jan.pavlinec1@gmail.com>

	config PACKAGE_tinc
		tristate "tinc................................................ VPN tunneling daemon"
		default y if DEFAULT_tinc
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_zlib
		select PACKAGE_kmod-tun
		select PACKAGE_liblzo
		select PACKAGE_libopenssl
		help
		 Tinc is a Virtual Private Network (VPN) daemon that uses tunnelling and
		   encryption to create a secure private network between hosts on the Internet.
		 http://www.tinc-vpn.org/
		 Saverio Proto <zioproto@gmail.com>

	config PACKAGE_vpnc-scripts
		tristate "vpnc-scripts........... VPN configuration script for vpnc and OpenConnect"
		default y if DEFAULT_vpnc-scripts
		default m if ALL
		select PACKAGE_libc
		help
		 This package contains the vpnc-script which is used by vpnc
		 	and OpenConnect to configure the tunnel interface.
		 Nikos Mavrogiannopoulos <n.mavrogiannopoulos@gmail.com>

	config PACKAGE_wireguard-tools
		tristate "wireguard-tools................. WireGuard userspace control program (wg)"
		default y if DEFAULT_wireguard-tools
		default m if ALL
		select PACKAGE_kmod-wireguard
		select PACKAGE_libc
		help
		 WireGuard is a novel VPN that runs inside the Linux Kernel and utilizes
		   state-of-the-art cryptography. It aims to be faster, simpler, leaner, and
		   more useful than IPSec, while avoiding the massive headache. It intends to
		   be considerably more performant than OpenVPN.  WireGuard is designed as a
		   general purpose VPN for running on embedded interfaces and super computers
		   alike, fit for many different circumstances. It uses UDP.
		 
		   This package provides the userspace control program for WireGuard,
		   `wg(8)`, a netifd protocol helper, and a re-resolve watchdog script.
		 https://www.wireguard.com
		 Jason A. Donenfeld <Jason@zx2c4.com>

	config PACKAGE_xl2tpd
		tristate "xl2tpd....................... An L2TP (Layer 2 Tunneling Protocol) daemon"
		default y if DEFAULT_xl2tpd
		default m if ALL
		select PACKAGE_libtlt-logger
		select PACKAGE_ppp-mod-pppol2tp
		select PACKAGE_kmod-l2tp-eth
		depends on (PACKAGE_ppp||PACKAGE_ppp-multilink)
		select PACKAGE_libc
		depends on PACKAGE_kmod-ppp
		select PACKAGE_kmod-l2tp-ip
		select PACKAGE_resolveip
		help
		 l2tpd is the open source implementation of the L2TP tunneling protocol (RFC2661).
		 It does implement both LAC and LNS role in a L2TP networking architecture. The
		 main goal of this protocol is to tunnel PPP frame trough an IP network.
		 http://www.xelerance.com/software/xl2tpd/
		 Yousong Zhou <yszhou4tech@gmail.com>

	config PACKAGE_xl2tpd6
		tristate "xl2tpd6.................................... L2TP daemon with IPv6 support"
		default y if DEFAULT_xl2tpd6
		default m if ALL
		select PACKAGE_kmod-l2tp-eth
		select PACKAGE_libtlt-logger
		select PACKAGE_kmod-l2tp
		select PACKAGE_libpthread
		select PACKAGE_libc
		select PACKAGE_kmod-l2tp-ip
		help
		 xl2tpd6 is a daemon that manages Layer 2 Tunneling Protocol (L2TP) tunnels.
		   It is based on xl2tpd with added IPv6 support.
		 https://github.com/ulysse31/xl2tpd6
		 

	config PACKAGE_zerotier
		tristate "zerotier.. Create flat virtual Ethernet networks of almost unlimited size"
		default y if DEFAULT_zerotier
		default m if ALL
		select PACKAGE_tc-tiny
		select PACKAGE_libminiupnpc
		select PACKAGE_kmod-sched-flower
		select PACKAGE_ucode
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_zerotier
		select PACKAGE_libpthread
		select PACKAGE_libc
		select PACKAGE_libucode
		select PACKAGE_kmod-tun
		select PACKAGE_libnatpmp
		select PACKAGE_libstdcpp
		select PACKAGE_libatomic
		select PACKAGE_kmod-sched-act-police
		help
		 ZeroTier package can establish Peer to Peer VPN (P2PVPN) connection
		 	between various devices running various operating systems. It also provides
		 	network management possibilities such as routing and creating firewall rules.
		 https://www.zerotier.com
		 Moritz Warning <moritzwarning@web.de>


		source "package/network/services/zerotier/Config.in"

endmenu
menu "WWAN"
	config PACKAGE_uqmi
		tristate "uqmi......................... Control utility for mobile broadband modems"
		default y if DEFAULT_uqmi
		default m if ALL
