		 Jo-Philipp Wich <jo@mein.io>

	config PACKAGE_luasec
		tristate "luasec............................................................ LuaSec"
		default y if DEFAULT_luasec
		default m if ALL
		select PACKAGE_lua
		select PACKAGE_libopenssl
		select PACKAGE_libc
		select PACKAGE_luasocket
		help
