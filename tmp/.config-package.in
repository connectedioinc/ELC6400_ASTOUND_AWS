		select PACKAGE_libc
		select PACKAGE_libmdcollect
		select PACKAGE_libgsm
		select PACKAGE_libnetsnmp
		select PACKAGE_libubox
		help
		 SNMP GSM module
		 

	config PACKAGE_snmp-mod-io
		tristate "snmp-mod-io.............................................. SNMP I/O module"
		default y if DEFAULT_snmp-mod-io
		default m if ALL
		select PACKAGE_libubox
		select PACKAGE_libnetsnmp
		select PACKAGE_libc
		select PACKAGE_libubus
		select PACKAGE_iomand
		help
