		default y if DEFAULT_gpsd
		default m if ALL
		select PACKAGE_libuci
		select PACKAGE_libcurl
		select PACKAGE_libmnfinfo
		select PACKAGE_libsqlite3
		select PACKAGE_libgsm
		select PACKAGE_liblog
		select PACKAGE_libboardjson
		select PACKAGE_libubus
		select PACKAGE_libpthread
		select PACKAGE_libtlt_termios
		select PACKAGE_libc
		select PACKAGE_libgps
		select PACKAGE_libtlt_uci
		select PACKAGE_zlib
		select PACKAGE_iomand if IO_SUPPORT
		select PACKAGE_liburc
		help
		 Deamon providing gps related functionality.
		 

	config PACKAGE_host_block
		tristate "host_block.................................................... Host Block"
		default y if DEFAULT_host_block
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_dnsmasq if PACKAGE_dnsmasq-dhcpv6<PACKAGE_host_block&&PACKAGE_dnsmasq-full<PACKAGE_host_block
		help
		 Host Block
		 

	config PACKAGE_impulse-counter
		tristate "impulse-counter.......................................... Impulse counter"
		default y if DEFAULT_impulse-counter
		default m if ALL
		select PACKAGE_libtlt_uci
		select PACKAGE_libubus
		select PACKAGE_libuci
		select PACKAGE_libc
		select PACKAGE_libubox
		select PACKAGE_libblobmsg-json
		select PACKAGE_iomand
		select PACKAGE_lsqlite3
		select PACKAGE_libtlt-logger
		help
		 Impulse counter application is used to count impulse signals and store them in a database.
		 

	config PACKAGE_io_scheduler
		tristate "io_scheduler.................... Daemon providing I/O scheduling features"
		default y if DEFAULT_io_scheduler
		default m if ALL
