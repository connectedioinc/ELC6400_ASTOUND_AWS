		select PACKAGE_freeradius3-mod-chap
		select PACKAGE_freeradius3-common
		select PACKAGE_freeradius3-mod-attr-filter
		select PACKAGE_freeradius3-mod-eap-pwd
		select PACKAGE_freeradius3-mod-logintime
		select PACKAGE_freeradius3-mod-always
		select PACKAGE_freeradius3-mod-realm
		select PACKAGE_freeradius3-mod-eap-md5
		select PACKAGE_freeradius3-mod-eap-tls
