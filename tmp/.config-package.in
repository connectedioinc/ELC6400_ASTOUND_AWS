	config PACKAGE_kmod-gpio-it87
		tristate "kmod-gpio-it87................... GPIO support for IT87xx Super I/O chips"
		default y if DEFAULT_kmod-gpio-it87
		default m if ALL||ALL_NONSHARED||ALL_KMODS
