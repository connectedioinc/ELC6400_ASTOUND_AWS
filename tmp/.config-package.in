		default y if DEFAULT_kmod-i2c-smbus
		default m if ALL||ALL_NONSHARED||ALL_KMODS
		select PACKAGE_kmod-i2c-core
		help
		 Support for the SMBus extensions to the I2C specification.
		 

	config PACKAGE_kmod-i2c-tiny-usb
