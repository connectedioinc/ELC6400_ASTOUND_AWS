	config PACKAGE_mosquitto-client-nossl
		tristate "mosquitto-client-nossl.... mosquitto - client tools (Without SSL support)"
		default y if DEFAULT_mosquitto-client-nossl
		default m if ALL
		select PACKAGE_libubox
		select PACKAGE_libmosquitto-nossl
		select PACKAGE_librt
		select PACKAGE_ubus
		select PACKAGE_libcares
		select PACKAGE_tpm2_importer if TPM_SUPPORT
		select PACKAGE_cJSON
		select PACKAGE_libc
		select PACKAGE_libuci
		help
		 Command line client tools for working with mosquitto.
		 This includes mosquitto_sub, mosquitto_pub, mosquitto_rr
		 and the mosquitto_ctrl tool.
		         This package is built without SSL support
		 http://www.mosquitto.org/
		 Karl Palsson <karlp@etactica.com>

	config PACKAGE_mosquitto-client-ssl
		tristate "mosquitto-client-ssl......... mosquitto - client tools (With SSL support)"
		default y if DEFAULT_mosquitto-client-ssl
		default m if ALL
		select PACKAGE_librt
		select PACKAGE_libubox
		select PACKAGE_ubus
		select PACKAGE_libuci
		select PACKAGE_libmosquitto-ssl
		select PACKAGE_libcares
		select PACKAGE_tpm2_importer if TPM_SUPPORT
		select PACKAGE_libc
		select PACKAGE_cJSON
		help
		 Command line client tools for working with mosquitto.
		 This includes mosquitto_sub, mosquitto_pub, mosquitto_rr
		 and the mosquitto_ctrl tool.
		         This package is built with SSL support
		 http://www.mosquitto.org/
		 Karl Palsson <karlp@etactica.com>

	config PACKAGE_mosquitto-nossl
		tristate "mosquitto-nossl. mosquitto - an MQTT message broker (without SSL support)"
		default y if DEFAULT_mosquitto-nossl
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_tpm2_importer if TPM_SUPPORT
		select PACKAGE_libuci
		select PACKAGE_libubox
		select PACKAGE_librt
		select PACKAGE_ubus
		help
		 Mosquitto is an open source (BSD licensed) message broker that implements
		 the MQTT protocol version 3.1, 3.1.1 and 5. MQTT provides a lightweight
		 method of carrying out messaging using a publish/subscribe model.
		 
		 This package also includes some basic support for configuring via UCI
		         This package is built WITHOUT SSL support.
		 http://www.mosquitto.org/
		 Karl Palsson <karlp@etactica.com>

	config PACKAGE_mosquitto-ssl
		tristate "mosquitto-ssl...... mosquitto - an MQTT message broker (with SSL support)"
		default y if DEFAULT_mosquitto-ssl
		default m if ALL
		select PACKAGE_libopenssl
		select PACKAGE_librt
		select PACKAGE_libubox
		select PACKAGE_libuci
		select PACKAGE_tpm2_importer if TPM_SUPPORT
		select PACKAGE_cJSON if MOSQUITTO_DYNAMIC_SECURITY
		select PACKAGE_libc
		select PACKAGE_ubus
		select PACKAGE_libwebsockets-openssl if MOSQUITTO_LWS
		help
		 Mosquitto is an open source (BSD licensed) message broker that implements
		 the MQTT protocol version 3.1, 3.1.1 and 5. MQTT provides a lightweight
		 method of carrying out messaging using a publish/subscribe model.
		 
		 This package also includes some basic support for configuring via UCI
		 This package is built with SSL support.  TLS-PSK will be included (in both
		 the client and broker) if OpenSSL is built with TLS-PSK support.
		 http://www.mosquitto.org/
		 Karl Palsson <karlp@etactica.com>


		source "package/network/services/mosquitto/Config.in"

