menu "Time Synchronization"
	config PACKAGE_ntp-keygen
		tristate "ntp-keygen................................................ ISC ntp keygen"
		default y if DEFAULT_ntp-keygen
		default m if ALL
		select PACKAGE_libevent2-core
		select PACKAGE_libopenssl
		select PACKAGE_libc
		select PACKAGE_libcap
		select PACKAGE_libpthread
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains the ntp-keygen.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_ntp-utils
		tristate "ntp-utils.............................................. ISC ntp utilities"
		default y if DEFAULT_ntp-utils
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libcap
		select PACKAGE_libpthread
		select PACKAGE_libevent2-pthreads
		select PACKAGE_libopenssl
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains ntpdc, ntpq, ntptime and sntp.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_ntpclient
		tristate "ntpclient............................. NTP (Network Time Protocol) client"
		default y if DEFAULT_ntpclient
		default m if ALL
		select PACKAGE_libubus
		select PACKAGE_libuci
		select PACKAGE_libc
		select PACKAGE_libgsm if MOBILE_SUPPORT
		select PACKAGE_librt
		select PACKAGE_libblobmsg-json
		select PACKAGE_libubox
		help
		 NTP client for setting system time from NTP servers.
		 

	config PACKAGE_ntpd
		tristate "ntpd...................................................... ISC ntp server"
		default y if DEFAULT_ntpd
		default m if ALL
		select PACKAGE_libpthread
		select PACKAGE_libc
		select PACKAGE_libcap
		select PACKAGE_libopenssl
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains the ntpd server.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

	config PACKAGE_ntpdate
		tristate "ntpdate..................................................... ISC ntp date"
		default y if DEFAULT_ntpdate
		default m if ALL
		select PACKAGE_libcap
		select PACKAGE_libc
		select PACKAGE_libpthread
		select PACKAGE_libopenssl
		help
		 The ISC ntp suite is a collection of tools used to synchronize the
		  system clock with remote NTP time servers and run/monitor local NTP
		  servers.
		  .
		  This package contains ntpdate.
		 http://www.ntp.org/
		 Peter Wagner <tripolar@gmx.at>

endmenu
menu "VPN"
	config PACKAGE_dmvpn
		tristate "dmvpn.................... Dynamic multipoint VPN using NHRP GRE and IPsec"
		default y if DEFAULT_dmvpn
		default m if ALL
		select PACKAGE_kmod-ipsec6 if IPV6
		select PACKAGE_frr-nhrp
		select PACKAGE_kmod-gre6 if IPV6
		select PACKAGE_kmod-crypto-authenc
		select PACKAGE_kmod-ipt-ipsec
		select PACKAGE_kmod-ipsec
		select PACKAGE_kmod-ipsec4
		select PACKAGE_kmod-gre
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_dmvpn
		select PACKAGE_frr
		select PACKAGE_iptables-mod-ipsec
		select PACKAGE_libpthread
		select PACKAGE_resolveip
		depends on PACKAGE_iptables
		select PACKAGE_libc
		help
		 Dynamic Multipoint VPN (DMVPN) is a method of building scalable IPsec VPNs.
		 	DMVPN is configured as a hub-and-spoke network, where tunnels between spokes
		 	are built dynamically; therefore, no change in configuration is required on
		 	the hub in order to connect new spokes.
		 

	config PACKAGE_eoip
		tristate "eoip....................... Ethernet over IP tunnel (Mikrotik compatible)"
		default y if DEFAULT_eoip
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_kmod-tun
		help
		 Ethernet over IP tunnel (Mikrotik compatible)
		 

	config PACKAGE_openconnect
		tristate "openconnect"
		default y if DEFAULT_openconnect
		default m if ALL
		select PACKAGE_vpnc-scripts
		select PACKAGE_libstoken if OPENCONNECT_STOKEN
		select PACKAGE_resolveip
		select PACKAGE_libintl-full if BUILD_NLS
		select PACKAGE_libc
		select PACKAGE_kmod-tun
		select PACKAGE_p11-kit if OPENCONNECT_OPENSSL
		select PACKAGE_libtasn1 if OPENCONNECT_GNUTLS
		select PACKAGE_libxml2
		select PACKAGE_libiconv-full if BUILD_NLS
		select PACKAGE_libgnutls if OPENCONNECT_GNUTLS
		select PACKAGE_libp11 if OPENCONNECT_OPENSSL
		select PACKAGE_libopenssl if OPENCONNECT_OPENSSL
		help
		 A VPN client compatible with several SSL VPN implementations (ocserv, Cisco AnyConnect, Juniper, Palo Alto)
		 
		 	OpenConnect is an SSL VPN client initially created to support Cisco's
		 	AnyConnect SSL VPN. It has since been extended to support the Pulse Connect
		 	Secure VPN (formerly known as Juniper Network Connect or Junos Pulse) and
		 	the Palo Alto Networks GlobalProtect SSL VPN.
		 
		 	A corresponding OpenConnect VPN server implementation can be found in the
		 	ocserv package.
		 https://www.infradead.org/openconnect/
		 Nikos Mavrogiannopoulos <n.mavrogiannopoulos@gmail.com>


		source "package/network/services/openconnect/Config.in"

	menuconfig PACKAGE_openvpn-openssl
		tristate "openvpn-openssl................... Open source VPN solution using OpenSSL"
		default y if DEFAULT_openvpn-openssl
		default m if ALL
		select PACKAGE_liblzo if OPENVPN_openssl_ENABLE_LZO
		select PACKAGE_libcap
		select PACKAGE_liblz4 if OPENVPN_openssl_ENABLE_LZ4
		select PACKAGE_libtlt-logger
		select PACKAGE_libnl-genl if OPENVPN_openssl_ENABLE_DCO
		select PACKAGE_libopenssl
		select PACKAGE_libubox
		select PACKAGE_libubus
		select PACKAGE_libc
		select PACKAGE_ip-tiny if OPENVPN_openssl_ENABLE_IPROUTE2 && PACKAGE_ip-full<PACKAGE_openvpn-openssl
		select PACKAGE_kmod-tun
		help
		 Open source VPN solution using OpenSSL
		 http://openvpn.net
		 Magnus Kroken <mkroken@gmail.com>


		source "package/network/services/openvpn/Config-openssl.in"

	config PACKAGE_pptpd
		tristate "pptpd................................................. PopTop pptp server"
		default y if DEFAULT_pptpd
		default m if ALL
		select PACKAGE_kmod-mppe
		depends on (PACKAGE_ppp||PACKAGE_ppp-multilink)
		depends on PACKAGE_kmod-ppp
		select PACKAGE_kmod-gre
		select PACKAGE_libc
		select PACKAGE_ppp-mod-pptp
		select PACKAGE_ppp-mod-pppoe
		help
		 PopTop pptp server
		 http://poptop.sourceforge.net/
		 

	config PACKAGE_sstp-client
		tristate "sstp-client...................... SSTP-Client is a SSTP client for Linux."
		default y if DEFAULT_sstp-client
		default m if ALL
		select PACKAGE_ppp
		select PACKAGE_libevent2
		select PACKAGE_resolveip
		select PACKAGE_libc
		select PACKAGE_libopenssl
		help
		 Secure Socket Tunneling Protocol (SSTP) is a VPN protocol
		 	designed to transport PPP traffic via a secure SSL/TLS channel.
		 http://sstp-client.sourceforge.net/
		 Federico Di Marco <fededim@gmail.com>

	menuconfig PACKAGE_strongswan
		tristate "strongswan.................................................... StrongSwan"
		default y if DEFAULT_strongswan
		default m if ALL
		select PACKAGE_kmod-lib-zlib-deflate
		select PACKAGE_kmod-crypto-echainiv
		select PACKAGE_kmod-ipsec6 if IPV6
		select PACKAGE_kmod-crypto-cbc
		select PACKAGE_kmod-crypto-authenc
		select PACKAGE_kmod-crypto-aead
		select PACKAGE_kmod-ipsec
		select PACKAGE_kmod-crypto-sha1
		select PACKAGE_kmod-ipsec4
		select PACKAGE_kmod-crypto-md5
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_strongswan
		select PACKAGE_kmod-lib-zlib-inflate
		select PACKAGE_kmod-crypto-hmac
		select PACKAGE_libpthread
		select PACKAGE_libc
		select PACKAGE_kmod-crypto-des
		help
		 StrongSwan is an OpenSource IPsec implementation for the Linux operating system.
		  This package contains shared libraries and scripts.
		 http://www.strongswan.org/
		 Philip Prindeville <philipp@redfish-solutions.com>, Noel Kuntze <noel.kuntze@thermi.consulting>


	  source "package/network/services/strongswan/Config.in"

	config PACKAGE_strongswan-charon
		tristate "strongswan-charon................... StrongSwan IKEv1/IKEv2 keying daemon"
		default y if DEFAULT_strongswan-charon
		default m if ALL
		select PACKAGE_libc
		depends on PACKAGE_strongswan
		help
		 StrongSwan is an OpenSource IPsec implementation for the Linux operating system.
		  This package contains charon, an IKEv2 keying daemon.
		 http://www.strongswan.org/
		 Philip Prindeville <philipp@redfish-solutions.com>, Noel Kuntze <noel.kuntze@thermi.consulting>

	config PACKAGE_strongswan-charon-cmd
