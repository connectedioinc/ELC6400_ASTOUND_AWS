	config PACKAGE_frr-zebra
		tristate "frr-zebra................................................... Zebra daemon"
		default y if DEFAULT_frr-zebra
		default y if PACKAGE_frr
		select PACKAGE_libc
		depends on PACKAGE_frr
		select PACKAGE_frr-libfrr
		help
		 Zebra daemon
		 https://www.frrouting.org/
		 Lucian Cristian <lucian.cristian@gmail.com>

	config PACKAGE_genl
		tristate "genl.................................... General netlink utility frontend"
		default y if DEFAULT_genl
		default m if ALL
		select PACKAGE_libnl-tiny
		select PACKAGE_libc
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		help
		 General netlink utility frontend
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_igmpproxy
		tristate "igmpproxy....................................... Multicast Routing Daemon"
		default y if DEFAULT_igmpproxy
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_librt if USE_GLIBC
		help
		 IGMPproxy is a simple dynamic Multicast Routing Daemon
		 	which enables the ability for the router to learn multicast group membership information
		 	and forward multicast packets
		 http://sourceforge.net/projects/igmpproxy
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_ip-bridge
		tristate "ip-bridge..................... Bridge configuration utility from iproute2"
		default y if DEFAULT_ip-bridge
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		select PACKAGE_libnl-tiny
		help
		 Bridge configuration utility from iproute2
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_ip-full
		tristate "ip-full................................... Routing control utility (full)"
		default y if DEFAULT_ip-full
		default m if ALL
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		select PACKAGE_libc
		select PACKAGE_libnl-tiny
		help
		 Routing control utility (full)
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_ip-tiny
		tristate "ip-tiny................................ Routing control utility (minimal)"
		default y if DEFAULT_ip-tiny
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		select PACKAGE_libnl-tiny
		help
		 Routing control utility (minimal)
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_mwan3
		tristate "mwan3........... Multiwan hotplug script with connection tracking support"
		default y if DEFAULT_mwan3
		default m if ALL
		select PACKAGE_iptables-mod-ipopt
		select PACKAGE_iptables-mod-conntrack-extra
		select PACKAGE_libc
		select PACKAGE_iptables
		select PACKAGE_jshn
		select PACKAGE_ipset
		select PACKAGE_rpcd
		select PACKAGE_ip-tiny if PACKAGE_ip-full<PACKAGE_mwan3
		help
		 Hotplug script which makes configuration of multiple WAN interfaces simple
		 and manageable. With loadbalancing/failover support for up to 250 wan
		 interfaces, connection tracking and an easy to manage traffic ruleset.
		 Florian Eckert <fe@dev.tdt.de>

	config PACKAGE_nstat
		tristate "nstat......................................... Network statistics utility"
		default y if DEFAULT_nstat
		default m if ALL
		select PACKAGE_libnl-tiny
		select PACKAGE_libc
		select PACKAGE_libmnl if (PACKAGE_devlink||PACKAGE_rdma)
		help
		 Network statistics utility
		 http://www.linuxfoundation.org/collaborate/workgroups/networking/iproute2
		 Russell Senior <russell@personaltelco.net>

	config PACKAGE_rdma
		tristate "rdma................................................ Network rdma utility"
		default y if DEFAULT_rdma
