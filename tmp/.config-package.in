		 overwrite those supplied by the ath10k-firmware-* packages.
		 
		 This is package is only necessary for the Qxwlan E2600AC.
		 
		 Do not install it for any other device!
		 

	config PACKAGE_ipq-wifi-teltonika_rutx
		tristate "ipq-wifi-teltonika_rutx......... board-2.bin Overrides for Teltonika RUTX"
		default y if DEFAULT_ipq-wifi-teltonika_rutx
		default m if ALL||ALL_NONSHARED
		select PACKAGE_libc
		depends on (TARGET_ipq40xx||TARGET_ipq806x)
		depends on m || (PACKAGE_ipq-wifi-8dev_habanero-dvk != y)
		depends on m || (PACKAGE_ipq-wifi-aruba_ap-303 != y)
		depends on m || (PACKAGE_ipq-wifi-avm_fritzrepeater-1200 != y)
		depends on m || (PACKAGE_ipq-wifi-buffalo_wtr-m2133hp != y)
		depends on m || (PACKAGE_ipq-wifi-cellc_rtl30vw != y)
		depends on m || (PACKAGE_ipq-wifi-devolo_magic-2-wifi-next != y)
		depends on m || (PACKAGE_ipq-wifi-dlink_dap2610 != y)
		depends on m || (PACKAGE_ipq-wifi-edgecore_ecw5410 != y)
		depends on m || (PACKAGE_ipq-wifi-edgecore_oap100 != y)
		depends on m || (PACKAGE_ipq-wifi-engenius_eap2200 != y)
		depends on m || (PACKAGE_ipq-wifi-engenius_emd1 != y)
		depends on m || (PACKAGE_ipq-wifi-engenius_emr3500 != y)
		depends on m || (PACKAGE_ipq-wifi-ezviz_cs-w3-wd1200g-eup != y)
		depends on m || (PACKAGE_ipq-wifi-glinet_gl-ap1300 != y)
		depends on m || (PACKAGE_ipq-wifi-glinet_gl-s1300 != y)
		depends on m || (PACKAGE_ipq-wifi-linksys_ea8300 != y)
		depends on m || (PACKAGE_ipq-wifi-linksys_mr8300-v0 != y)
		depends on m || (PACKAGE_ipq-wifi-luma_wrtq-329acn != y)
		depends on m || (PACKAGE_ipq-wifi-mikrotik_hap-ac2 != y)
		depends on m || (PACKAGE_ipq-wifi-mikrotik_sxtsq-5-ac != y)
		depends on m || (PACKAGE_ipq-wifi-mobipromo_cm520-79f != y)
		depends on m || (PACKAGE_ipq-wifi-nec_wg2600hp3 != y)
		depends on m || (PACKAGE_ipq-wifi-plasmacloud_pa1200 != y)
		depends on m || (PACKAGE_ipq-wifi-plasmacloud_pa2200 != y)
		depends on m || (PACKAGE_ipq-wifi-qxwlan_e2600ac != y)
		help
		 The Teltonika RUTX requires board-specific, reference ("cal") data
		 that is not yet present in the upstream wireless firmware distribution.
		 
		 This package supplies board-2.bin file(s) that, in the interim,
		 overwrite those supplied by the ath10k-firmware-* packages.
		 
		 This is package is only necessary for the Teltonika RUTX.
		 
		 Do not install it for any other device!
		 

endmenu
