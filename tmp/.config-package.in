		tristate "snmp-mod-port........................................... SNMP Port module"
		default y if DEFAULT_snmp-mod-port
		default m if ALL
		select PACKAGE_libapi
		select PACKAGE_libubox
		select PACKAGE_libnetsnmp
		select PACKAGE_libc
		select PACKAGE_libubus
		help
		 SNMP Port module
		 

	config PACKAGE_snmp-mod-sqm
		tristate "snmp-mod-sqm............................. SNMP traffic shaping/SQM module"
		default y if DEFAULT_snmp-mod-sqm
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libuci
		select PACKAGE_libubus
		select PACKAGE_libubox
		select PACKAGE_libnetsnmp
		help
		 SNMP traffic shaping/SQM module
		 

	config PACKAGE_snmp-mod-universalgwd
		tristate "snmp-mod-universalgwd...................... SNMP Universal Gateway module"
		default y if DEFAULT_snmp-mod-universalgwd
		default m if ALL
		select PACKAGE_libnetsnmp
		select PACKAGE_libubox
		select PACKAGE_libblobmsg-json
		select PACKAGE_libuci
		select PACKAGE_libubus
		select PACKAGE_libc
		select PACKAGE_libtag
		help
		 SNMP Universal Gateway module
		 

	config PACKAGE_snmp-mod-vlan
		tristate "snmp-mod-vlan........................................... SNMP VLAN module"
		default y if DEFAULT_snmp-mod-vlan
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_libuci
		select PACKAGE_libubus
		select PACKAGE_libubox
		select PACKAGE_libnetsnmp
		help
		 SNMP VLAN module
		 

	config PACKAGE_snmp-mod-wireless
		tristate "snmp-mod-wireless................................... SNMP wireless module"
		default y if DEFAULT_snmp-mod-wireless
		default m if ALL
		select PACKAGE_libnetsnmp
		select PACKAGE_libapi
		select PACKAGE_libblobmsg-json
		select PACKAGE_libubox
		select PACKAGE_libuci
		select PACKAGE_libubus
		select PACKAGE_libc
		help
		 SNMP wireless module
		 

endmenu
	config PACKAGE_avl
		tristate "avl............................... Daemon for sending data to AVL server."
		default y if DEFAULT_avl
		default m if ALL
		select PACKAGE_libgsm
		select PACKAGE_liblog
		select PACKAGE_iomand
		select PACKAGE_libmnfinfo
		select PACKAGE_libuci
		select PACKAGE_zlib
		select PACKAGE_libtlt_uci
		select PACKAGE_libgps
		select PACKAGE_libc
		select PACKAGE_libubus
		select PACKAGE_libpthread
		help
		 Daemon for sending data to AVL server.
		 

	config PACKAGE_aws
		tristate "aws........................................................... AWS client"
		default y if DEFAULT_aws
		default m if ALL
		select PACKAGE_libtlt-logger
		select PACKAGE_libaws-iot-device-sdk-embedded-C
		select PACKAGE_libmosquitto-ssl if PACKAGE_libmosquitto-nossl<PACKAGE_aws
		select PACKAGE_libatomic
		select PACKAGE_libapi
		select PACKAGE_libblobmsg-json
		select PACKAGE_libubox
		select PACKAGE_libtpm2_importer if TPM_SUPPORT
		select PACKAGE_libopenssl
		select PACKAGE_libc
		select PACKAGE_libuci
		select PACKAGE_libubus
		select PACKAGE_libmnfinfo
		select PACKAGE_libcurl
		help
		 AWS Cloud support.
		 

	config PACKAGE_azure_iothub
		tristate "azure_iothub........................................ Azure IoT Hub client"
		default y if DEFAULT_azure_iothub
		default m if ALL
		select PACKAGE_libtlt-logger
		select PACKAGE_libubox
		select PACKAGE_libblobmsg-json
		select PACKAGE_libapi
		select PACKAGE_libubus
		select PACKAGE_libuci
		select PACKAGE_liblua
		select PACKAGE_libc
		select PACKAGE_libtlt_uci
		select PACKAGE_libmnfinfo
		select PACKAGE_libazure-iot-sdk-c
		help
		 Azure IoT Hub is a utility meant to interact with
		 	Microsoft Azure IoT Hub cloud platform.
		 

	config PACKAGE_base-files
		tristate "base-files................................... Base filesystem for OpenWrt"
		default y if DEFAULT_base-files
		default m if ALL||ALL_NONSHARED
		select PACKAGE_usign if SIGNATURE_CHECK
		select PACKAGE_libc
		select PACKAGE_fstools
		select PACKAGE_openwrt-keyring if SIGNATURE_CHECK
		select PACKAGE_jsonfilter
		select PACKAGE_fwtool if !BUILD_FACTORY_TEST_IMAGE
		select PACKAGE_ubi-utils if NAND_SUPPORT
		select PACKAGE_netifd
		help
		 This package contains a base filesystem and system scripts for OpenWrt.
		 http://openwrt.org/
		 

	config PACKAGE_blesemd
		tristate "blesemd.................... Bluetooth Low Energy Sensor management daemon"
		default y if DEFAULT_blesemd
		default m if ALL
		select PACKAGE_libblobmsg-json
		select PACKAGE_lsqlite3
		depends on !(USB_SUPPORT && USE_RFKILL) || USE_RFKILL
		select PACKAGE_bluez-libs
		select PACKAGE_libc
		select PACKAGE_libubus
		select PACKAGE_libuci
		help
		 Management utility for Bluetooth Low Energy devices
		 

	config PACKAGE_block-mount
		tristate "block-mount........................... Block device mounting and checking"
		default y if DEFAULT_block-mount
		default m if ALL||ALL_NONSHARED
		select PACKAGE_libblobmsg-json
		select PACKAGE_libubox
		select PACKAGE_ubox
		select PACKAGE_libc
		select PACKAGE_libuci
		select PACKAGE_libjson-c
		help
		 Block device mounting and checking
		 John Crispin <john@phrozen.org>

	config PACKAGE_blockd
		tristate "blockd......................................... Block device automounting"
		default y if DEFAULT_blockd
		default m if ALL||ALL_NONSHARED
		select PACKAGE_fstools
		select PACKAGE_libc
		select PACKAGE_libubus
		select PACKAGE_libjson-c
		select PACKAGE_kmod-fs-autofs4
		select PACKAGE_libblobmsg-json
		select PACKAGE_block-mount
		help
		 Block device automounting
		 John Crispin <john@phrozen.org>

	config PACKAGE_busybox
		tristate "busybox................................ Core utilities for embedded Linux"
		default y if DEFAULT_busybox
		default m if ALL
		select PACKAGE_libnetifd if BUSYBOX_CONFIG_FEATURE_NETIFD
		select PACKAGE_libpam if BUSYBOX_CONFIG_PAM
		select PACKAGE_libubox
		select PACKAGE_libtlt-logger if BUSYBOX_CONFIG_PASSWD
		select PACKAGE_libuci if BUSYBOX_CONFIG_FEATURE_PASSWORD_POLICY
		select PACKAGE_jsonfilter if BUSYBOX_CONFIG_NTPD
		select PACKAGE_libubus
		select PACKAGE_libtlt-logger if BUSYBOX_CONFIG_FEATURE_IP_BLOCKD
		select PACKAGE_libc
		help
		 The Swiss Army Knife of embedded Linux.
		  It slices, it dices, it makes Julian Fries.
		 http://busybox.net/
		 Felix Fietkau <nbd@nbd.name>


		source "package/utils/busybox/Config.in"

	config PACKAGE_ca-bundle
		tristate "ca-bundle............................. System CA certificates as a bundle"
		default y if DEFAULT_ca-bundle
		default m if ALL
		select PACKAGE_libc
		help
		 System CA certificates as a bundle
		 

	config PACKAGE_ca-certificates
		tristate "ca-certificates................................... System CA certificates"
		default y if DEFAULT_ca-certificates
		default m if ALL
		select PACKAGE_libc
		help
		 System CA certificates
		 

	config PACKAGE_dnsmasq
		tristate "dnsmasq.............................................. DNS and DHCP server"
		default y if DEFAULT_dnsmasq
		default m if ALL
		select PACKAGE_libpcre if AP_DEVICE
		select PACKAGE_libubus
		select PACKAGE_libc
		help
		 It is intended to provide coupled DNS and DHCP service to a LAN.
		 http://www.thekelleys.org.uk/dnsmasq/
		 

	config PACKAGE_dnsmasq-dhcpv6
		tristate "dnsmasq-dhcpv6................. DNS and DHCP server (with DHCPv6 support)"
		default y if DEFAULT_dnsmasq-dhcpv6
		default m if ALL
		select PACKAGE_libpcre if AP_DEVICE
		select PACKAGE_libubus
		depends on IPV6
		select PACKAGE_libc
		help
		 It is intended to provide coupled DNS and DHCP service to a LAN.
		 
		 This is a variant with DHCPv6 support
		 http://www.thekelleys.org.uk/dnsmasq/
		 

	config PACKAGE_dnsmasq-full
		tristate "dnsmasq-full"
		default y if DEFAULT_dnsmasq-full
		default m if ALL
		select PACKAGE_libubus
		select PACKAGE_libpcre if AP_DEVICE
		select PACKAGE_libnetfilter-conntrack if PACKAGE_dnsmasq_full_conntrack
		select PACKAGE_libc
		select PACKAGE_nftables-json if PACKAGE_dnsmasq_full_nftset
		depends on !(PACKAGE_dnsmasq_full_nftset && IPV6) || IPV6
		select PACKAGE_libnettle if PACKAGE_dnsmasq_full_dnssec
		select PACKAGE_kmod-ipt-ipset if PACKAGE_dnsmasq_full_ipset
		help
		 It is intended to provide coupled DNS and DHCP service to a LAN.
		 
		 This is a fully configurable variant with DHCPv4, DHCPv6, DNSSEC, Authoritative DNS
		 and IPset, Conntrack support & NO_ID enabled by default.
		 http://www.thekelleys.org.uk/dnsmasq/
		 


		if PACKAGE_dnsmasq-full
		config PACKAGE_dnsmasq_full_dhcp
			bool "Build with DHCP support."
			default y
		config PACKAGE_dnsmasq_full_dhcpv6
			bool "Build with DHCPv6 support."
			depends on IPV6 && PACKAGE_dnsmasq_full_dhcp
			default y
		config PACKAGE_dnsmasq_full_dnssec
			bool "Build with DNSSEC support."
			default y
		config PACKAGE_dnsmasq_full_auth
			bool "Build with the facility to act as an authoritative DNS server."
			default y
		config PACKAGE_dnsmasq_full_ipset
			bool "Build with IPset support."
			default n
		config PACKAGE_dnsmasq_full_nftset
	                bool "Build with Nftset support."
			default y
		config PACKAGE_dnsmasq_full_conntrack
			bool "Build with Conntrack support."
			default y
		config PACKAGE_dnsmasq_full_noid
			bool "Build with NO_ID. (hide *.bind pseudo domain)"
			default y
		config PACKAGE_dnsmasq_full_broken_rtc
			bool "Build with HAVE_BROKEN_RTC."
			default n
		config PACKAGE_dnsmasq_full_tftp
			bool "Build with TFTP server support."
			default y
		endif

	config PACKAGE_dropbear
		tristate "dropbear........................................ Small SSH2 client/server"
		default y if DEFAULT_dropbear
		default m if ALL||ALL_NONSHARED
		select PACKAGE_libubox
		select PACKAGE_zlib if DROPBEAR_ZLIB
		select PACKAGE_libtlt-logger
		select PACKAGE_libc
		select PACKAGE_libubus
		help
		 A small SSH2 server/client designed for small memory environments.
		 http://matt.ucc.asn.au/dropbear/
		 


		source "package/network/services/dropbear/Config.in"

	config PACKAGE_email_to_sms
		tristate "email_to_sms........................................... POP3 email to SMS"
		default y if DEFAULT_email_to_sms
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_lua-pop3
		help
		 Enable this option in order to include POP3 email to SMS
		 

	menuconfig PACKAGE_event-juggler
		tristate "event-juggler...................................... Event juggler package"
		default y if DEFAULT_event-juggler
		default m if ALL
		select PACKAGE_libmosquitto-ssl if PACKAGE_libmosquitto-nossl<PACKAGE_event-juggler
		select PACKAGE_libsqlite3
		select PACKAGE_iomand if PACKAGE_EVENT_JUGGLER_CONDITION_IO
		select PACKAGE_libmctl if PACKAGE_EVENT_JUGGLER_ACTION_MODEM
		select PACKAGE_iomand if PACKAGE_EVENT_JUGGLER_EVENT_IO
		select PACKAGE_libcfg
		select PACKAGE_libuci
		select PACKAGE_liblua
		select PACKAGE_libcurl
		select PACKAGE_libgsm if CONFIG_MOBILE_SUPPORT
		select PACKAGE_libtlt-logger
		select PACKAGE_libgps if PACKAGE_EVENT_JUGGLER_EVENT_GPS
		select PACKAGE_libgps if PACKAGE_EVENT_JUGGLER_CONDITION_GPS
		select PACKAGE_libtpm2_importer if TPM_SUPPORT
		select PACKAGE_libapi
		select PACKAGE_iomand if PACKAGE_EVENT_JUGGLER_ACTION_OUT
		select PACKAGE_libblobmsg-json
		select PACKAGE_libubox
		select PACKAGE_libubus
		select PACKAGE_libparam
		select PACKAGE_libc
		select PACKAGE_libtlt_smtp
		select PACKAGE_liburc if PACKAGE_EVENT_JUGGLER_EVENT_GSM
		select PACKAGE_libtlt_uci
		help
		 Event juggler package
		 


		source "package/teltonika/event_juggler/Config.in"

	config PACKAGE_firewall
		tristate "firewall.............................................. OpenWrt C Firewall"
		default y if DEFAULT_firewall
		default m if ALL
		select PACKAGE_libxtables
		select PACKAGE_libmnl
		select PACKAGE_kmod-nf-conntrack6 if IPV6
		select PACKAGE_iptables-mod-filter if AP_DEVICE
		select PACKAGE_libubus
		select PACKAGE_kmod-ipt-nat
		select PACKAGE_libc
		select PACKAGE_libip4tc
		select PACKAGE_libubox
		select PACKAGE_kmod-ipt-core
		select PACKAGE_kmod-ipt-conntrack
		select PACKAGE_libuci
		select PACKAGE_libnetfilter-conntrack
		depends on !(AP_DEVICE) || PACKAGE_iptables
		select PACKAGE_libip6tc if IPV6
		help
		 This package provides a config-compatible C implementation of the UCI firewall.
		 Jo-Philipp Wich <jo@mein.io>

	menuconfig PACKAGE_fstools
		tristate "fstools......................................... OpenWrt filesystem tools"
		default y if DEFAULT_fstools
		default m if ALL||ALL_NONSHARED
		select PACKAGE_ubi-utils if NAND_SUPPORT
		select PACKAGE_ubox
		select PACKAGE_libc
		help
		 OpenWrt filesystem tools
		 John Crispin <john@phrozen.org>


		config FSTOOLS_UBIFS_EXTROOT
			depends on PACKAGE_fstools
			depends on NAND_SUPPORT
			bool "Support extroot functionality with UBIFS"
			default y
			help
				This option makes it possible to use extroot functionality if the root filesystem resides on an UBIFS partition
	
		config FSTOOLS_OVL_MOUNT_FULL_ACCESS_TIME
			depends on PACKAGE_fstools
			bool "Full access time accounting"
			default n
			help
				This option enables the full access time accounting (warning: it will increase the flash writes).
	
		config FSTOOLS_OVL_MOUNT_COMPRESS_ZLIB
			depends on PACKAGE_fstools
			bool "Compress using zlib"
			default n
			help
				This option enables the compression using zlib on the storage device.
	
		config FSTOOLS_FS_ROOTFS_READONLY
			depends on PACKAGE_fstools
			bool "Mount rootfs in read-only mode"
			default y
			help
				This option enables mouting rootfs in read-only mode.

	config PACKAGE_fwcert
		tristate "fwcert......................... Firmware certificate verification utility"
		default y if DEFAULT_fwcert
		default m if ALL
		select PACKAGE_libc
		select PACKAGE_usign
		help
		 Firmware certificate verification utility
		 

	config PACKAGE_fwtool
		tristate "fwtool"
		default y if DEFAULT_fwtool
		default m if ALL||ALL_NONSHARED
		select PACKAGE_libc
		help
		 Utility for appending and extracting firmware metadata and signatures
		 Felix Fietkau <nbd@nbd.name>

