		select PACKAGE_libc
		help
		 StrongSwan is an OpenSource IPsec implementation for the Linux operating system.
		  This package contains the ipsec utility.
		 http://www.strongswan.org/
		 Philip Prindeville <philipp@redfish-solutions.com>, Noel Kuntze <noel.kuntze@thermi.consulting>

	config PACKAGE_strongswan-isakmp
		tristate "strongswan-isakmp.................................... StrongSwan (isakmp)"
		default y if DEFAULT_strongswan-isakmp
		default m if ALL
		select PACKAGE_strongswan-mod-socket-default
		select PACKAGE_strongswan-mod-updown
		select PACKAGE_strongswan-mod-des
		depends on PACKAGE_strongswan
		select PACKAGE_strongswan-mod-pubkey
		select PACKAGE_strongswan-mod-stroke
		select PACKAGE_strongswan-ipsec
		select PACKAGE_strongswan-mod-nonce
		select PACKAGE_strongswan-mod-random
		select PACKAGE_strongswan-mod-gmpdh
		select PACKAGE_strongswan-mod-aes
		select PACKAGE_strongswan-mod-sha1
		select PACKAGE_strongswan-mod-uci
		depends on (PACKAGE_strongswan-mod-kdf||PACKAGE_strongswan-mod-openssl||PACKAGE_strongswan-mod-wolfssl)
		select PACKAGE_libc
		select PACKAGE_strongswan-mod-kernel-netlink
		select PACKAGE_strongswan-mod-md5
		select PACKAGE_strongswan-charon
		select PACKAGE_strongswan-mod-hmac
		help
		 StrongSwan is an OpenSource IPsec implementation for the Linux operating system.
		  This meta-package contains only dependencies to establish  ISAKMP /
		  IKE PSK connections, dropping other capabilities in favor of small size
		  Can fit most routers even with 4Mb flash (after removing IPv6 support).
		 http://www.strongswan.org/
		 Philip Prindeville <philipp@redfish-solutions.com>, Noel Kuntze <noel.kuntze@thermi.consulting>

