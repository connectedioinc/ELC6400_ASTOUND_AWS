		select PACKAGE_libc
		select PACKAGE_libubox
		help
		 Transparent routing / relay daemon
		 Felix Fietkau <nbd@nbd.name>

	config PACKAGE_ss
		tristate "ss............................................. Socket statistics utility"
		default y if DEFAULT_ss
		default m if ALL
