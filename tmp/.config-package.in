menuconfig IMAGEOPT
	bool "Image configuration"
	default n
source "package/*/image-config.in"
menu "Base system"

menu "RMS"
	config PACKAGE_librms
		tristate "librms.............................. Library for handling rms information"
		default y if DEFAULT_librms
		default m if ALL
		select PACKAGE_libubus
		select PACKAGE_libc
		select PACKAGE_libblobmsg-json
		select PACKAGE_libubox
		help
		 Library for handling rms information
		 

	config PACKAGE_rms_mqtt
		tristate "rms_mqtt........................... MQTT application for RMS by Teltonika"
		default y if DEFAULT_rms_mqtt
		default m if ALL
		select PACKAGE_libboardjson
		select PACKAGE_libopenssl
		select PACKAGE_libuci
		select PACKAGE_libmnfinfo
		select PACKAGE_libblobmsg-json
		select PACKAGE_libubox
		select PACKAGE_libc
		select PACKAGE_libpthread
		select PACKAGE_libubus
		select PACKAGE_libtlt_uci
		select PACKAGE_libgsm if MOBILE_SUPPORT
		select PACKAGE_libmosquitto-ssl if PACKAGE_libmosquitto-nossl<PACKAGE_rms_mqtt
		help
		 MQTT application for RMS by Teltonika
		 

endmenu
menu "SNMP modules"
	config PACKAGE_snmp
		tristate "snmp................................................... SNMP Meta package"
		default y if DEFAULT_snmp
		default m if ALL
		select PACKAGE_libnetsnmp
		select PACKAGE_snmp-mod-io if IO_SUPPORT
		select PACKAGE_snmp-mod-universalgwd
		select PACKAGE_snmp-mod-gps if GPS_SUPPORT
		select PACKAGE_snmp-mod-wireless if WIFI_SUPPORT
		select PACKAGE_snmptrap
		select PACKAGE_snmp-mod-port
		select PACKAGE_snmp-mod-vlan
		select PACKAGE_snmp-mod-gsm if MOBILE_SUPPORT
		select PACKAGE_libubox
		select PACKAGE_snmp-mod-mwan3
		select PACKAGE_snmp-mod-device
		select PACKAGE_snmp-mod-chilli
		select PACKAGE_snmp-mib
		select PACKAGE_snmpd
		select PACKAGE_libubus
		select PACKAGE_libc
		select PACKAGE_snmp-mod-sqm
		help
		 SNMP is an SNMP protocol implementation with custom
		 	Teltonika modules, a unique MIB file and SNMP Traps.
		 

	config PACKAGE_snmp-mib
		tristate "snmp-mib............................................. SNMP teltonika MIBs"
		default y if DEFAULT_snmp-mib
		default m if ALL
		select PACKAGE_libc
		help
		 SNMP teltonika MIBs
		 

