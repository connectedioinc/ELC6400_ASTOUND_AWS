    "/logging/services/status/{id}": {
      "get": {
        "summary": "Returns information about log file",
        "tags": ["Logging Services"],
        "responses": {
          "200": {
            "description": "Returns about logfile if it exists and is not empty",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Operation status"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string",
                          "description": "Name of the service"
                        },
                        "log": {
                          "type": "string",
                          "description": "Logs collected from service with all instance logs"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
