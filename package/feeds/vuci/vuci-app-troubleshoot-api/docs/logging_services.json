                "data": {
                  "$ref": "#/components/schemas/logging_services_options"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "logging_services_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Configuration ID"
              }
            }
          },
          {
            "$ref": "#/components/schemas/logging_service_options"
          }
        ]
      },
      "logging_service_options": {
        "title": "Logging single options",
        "type": "object",
        "properties": {
          "name": {
            "x-web": {
              "pretty": "Name of service",
              "input-type": "input"
            },
            "format": "string",
            "type": "string",
            "maxLength": 255,
            "description": "Name of service"
          },
          "log_levels": {
            "x-web": {
              "pretty": "Log levels allowed to log from service.",
              "input-type": "select"
            },
            "type": "array",
            "format": "string",
            "description": "Select one or more log levels to be enabled from the service.",
            "items": {
              "type": "string",
              "enum": [
                "0",
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7"
              ]
            }
          }
        }
      }
