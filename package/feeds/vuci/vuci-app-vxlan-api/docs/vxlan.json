  "components": {
    "responses": {},
    "schemas": {
      "network_devices_vxlan_options": {
        "type": "object",
        "properties": {
          "name": {
            "x-web": {
              "input-type": "input",
              "pretty": "Name",
              "group": "General"
            },
            "type": "string",
            "description": "Name of the device."
          },
          "macaddr": {
            "x-web": {
              "input-type": "input",
              "pretty": "MAC address",
              "group": "General"
            },
            "type": "string",
            "format": "macaddr",
            "description": "MAC address overriding the default one for this device."
          },
          "mtu": {
            "x-web": {
              "input-type": "input",
              "pretty": "MTU",
              "group": "General"
            },
            "type": "string",
            "format": "irange(98,9000)",
            "description": "Sets the maximum transmission unit (MTU) size. It is the largest size of a protocol data unit (PDU) that can be transmitted in a single network layer transaction."
          },
          "type": {
            "type": "string",
            "description": "If set to bridge, creates a bridge of the given name using L2 devices listed in ports.",
            "readOnly": true
          },
          "vni": {
            "x-web": {
              "input-type": "input",
              "pretty": "VNI",
              "group": "General"
            },
            "type": "string",
            "format": "irange(1,16777215)",
            "description": "VXLAN network identifier."
          },
          "port": {
            "x-web": {
              "input-type": "input",
              "pretty": "Port",
              "group": "General"
            },
            "type": "string",
            "format": "irange(1,65535)",
            "description": "Specifies the UDP destination port to communicate to the remote VXLAN tunnel endpoint."
          },
          "local": {
            "x-web": {
              "input-type": "input",
              "pretty": "Local address",
              "group": "General"
            },
            "type": "string",
            "format": "ipaddr",
            "description": "Sets the local source IP address for VXLAN tunneling."
          },
          "remote": {
            "x-web": {
              "input-type": "input",
              "pretty": "Remote address",
              "group": "General"
            },
            "type": "string",
            "format": "ipaddr",
            "description": "Specifies the multicast group or remote IP address used for VXLAN tunneling."
          },
          "ageing": {
            "x-web": {
              "input-type": "input",
              "pretty": "Ageing",
              "group": "Advanced"
            },
            "type": "string",
            "format": "irange(1,4294967295)",
            "description": "Specifies the lifetime in seconds of FDB entries learnt by the kernel."
          },
          "maxaddress": {
            "x-web": {
              "input-type": "input",
              "pretty": "Max FDB entries",
              "group": "Advanced"
            },
            "type": "string",
            "format": "irange(1,4294967295)",
            "description": "Specifies the maximum number of FDB entries."
          },
          "udpcsum": {
            "x-web": {
              "input-type": "switch",
              "pretty": "IPv4 checksum",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Specifies if UDP checksum is calculated for transmitted packets over IPv4."
          },
          "learning": {
            "x-web": {
              "input-type": "switch",
              "pretty": "Learning",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Enables or disables MAC learning for VXLAN."
          },
          "proxy": {
            "x-web": {
              "input-type": "switch",
              "pretty": "Proxy",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Enables or disables ARP proxy for VXLAN."
          },
          "rsc": {
            "x-web": {
              "input-type": "switch",
              "pretty": "RSC",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Specifies if route short circuit is turned on."
          },
          "l2miss": {
            "x-web": {
              "input-type": "switch",
              "pretty": "L2miss",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Specifies if netlink LLADDR miss notifications are generated."
          },
          "l3miss": {
            "x-web": {
              "input-type": "switch",
              "pretty": "L3miss",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Specifies if netlink IP ADDR miss notifications are generated."
          },
          "udp6zerocsumtx": {
            "x-web": {
              "input-type": "switch",
              "pretty": "IPv6 TX checksum",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Enables or disables UDP checksum calculation for transmitted packets over IPv6."
          },
          "udp6zerocsumrx": {
            "x-web": {
              "input-type": "switch",
              "pretty": "IPv6 RX checksum",
              "group": "Advanced"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Allow incoming UDP packets over IPv6 with zero checksum field."
          }
        },
        "required": ["vni", "port", "remote"]
      },
