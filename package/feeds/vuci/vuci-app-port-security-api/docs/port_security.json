                "schema": {
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "data": {
                        "status": "timed-out",
                        "connected": false,
                        "response": "[58214.123404] RADIUS message: code=1 (Access-Request) identifier=0 length=65[58214.123465]    Attribute 1 (User-Name) length=3[58214.123478]       Value: '_'[58214.123486]    Attribute 4 (NAS-IP-Address) length=6[58214.123504]       Value: 127.0.0.1[58214.123512]    Attribute 2 (User-Password) length=18[58214.123559]       Value: 8ce160bc4315ead12a765b168b3c87c1[58214.123571]    Attribute 80 (Message-Authenticator) length=18[58214.123617]       Value: 338e4814a621e8e365cef1a482482cae[58214.124135] recvmsg[RADIUS]: Connection refusedTimed out"
                      }
                    }
                  },
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string"
                        },
                        "connected": {
                          "type": "boolean"
                        },
                        "response": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status",
                        "connected",
                        "response"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
