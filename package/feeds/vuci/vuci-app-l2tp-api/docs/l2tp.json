    "schemas": {
      "l2tp_client_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Turns the L2TP instance on or off."
          },
          "description": {
            "x-web": {
              "pretty": "Name",
              "input-type": "input"
            },
            "type": "string",
            "description": "Name of the L2TP instance.",
            "maxLength": 64
          },
          "server": {
            "type": "string",
            "x-web": {
              "pretty": "Server",
              "input-type": "input"
            },
            "description": "L2TP server's IP address or hostname.",
            "format": "regex",
            "pattern": "^((?:d{1,3}.){3}d{1,3}|[[a-fA-F0-9:]+]|(?:[a-fA-F0-9]{1,4}:){2,7}[a-fA-F0-9]{1,4}|(?:[a-zA-Z0-9-]+.)+[a-zA-Z]{2,})(?::d{1,5})?$"
          },
          "username": {
            "x-web": {
              "pretty": "Username",
              "input-type": "input"
            },
            "type": "string",
            "description": "Username used for authentication to the L2TP server."
          },
          "password": {
            "x-web": {
              "pretty": "Password",
              "input-type": "input"
            },
            "type": "string",
            "description": "Password used for authentication to the L2TP server."
          },
          "auth": {
            "x-web": {
              "pretty": "CHAP secret",
              "input-type": "input"
            },
            "minLength": 5,
            "type": "string",
            "description": "A secret used for L2TP Tunnel Authentication."
          },
          "mtu": {
            "type": "string",
            "x-web": {
              "pretty": "MTU",
              "input-type": "input"
            },
            "description": "Sets the maximum transmission unit (MTU) size. It is the largest size of a protocol data unit (PDU) that can be transmitted in a single network layer transaction.",
            "format": "irange(68, 9200)"
          },
          "defaultroute": {
            "x-web": {
              "pretty": "Default route",
              "input-type": "switch"
            },
            "type": "string",
            "description": "When set, this connection will become the device's default route."
          },
          "auth_chap": {
            "x-web": {
              "pretty": "Allow CHAP",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Allows CHAP authentication method to be used",
            "format": "is_bool"
          },
          "auth_pap": {
            "x-web": {
              "pretty": "Allow PAP",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Allow PAP authentication method to be used",
            "format": "is_bool"
          },
          "auth_mschap2": {
            "x-web": {
              "pretty": "Allow MSCHAP-v2",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Allow MSCHAP-v2 authentication method to be used",
            "format": "is_bool"
          },
          "pppd_options": {
            "x-web": {
              "pretty": "Custom options",
              "input-type": "input"
            },
            "type": "array",
            "description": "Custom pppd (Point-to-Point Protocol Daemon) options are used to configure and manage PPP connections.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["description"]
      },
      "l2tp_client_options_id": {
        "title": "l2tp_client_id",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "x-web": {
                  "pretty": "Configuration name",
                  "input-type": "input"
                }
              }
            },
            "required": ["id"]
          },
          {
            "$ref": "#/components/schemas/l2tp_client_options"
          }
        ]
      },
      "l2tp_server_options": {
        "type": "object",
        "title": "",
        "properties": {
          "enabled": {
            "type": "string",
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            },
            "description": "Turns the L2TP instance on or off"
          },
          "description": {
            "x-web": {
              "pretty": "Name",
              "input-type": "input"
            },
            "type": "string",
            "description": "Name of the L2TP instance.",
            "maxLength": 64
          },
          "use_ipv6": {
            "type": "string",
            "x-web": {
              "pretty": "Use IPv6",
              "input-type": "switch"
            },
            "description": "Enables an IPv6 socket to accept L2TP connections over IPv6.",
            "format": "is_bool"
          },
          "localip": {
            "type": "string",
            "x-web": {
              "pretty": "Local IP",
              "input-type": "input"
            },
            "description": "IP Address of this L2TP network interface."
          },
          "start": {
            "type": "string",
            "x-web": {
              "pretty": "Remote IP range begin",
              "input-type": "input"
            },
            "description": "L2TP IP address leases will begin from the address specified in this field."
          },
          "limit": {
            "type": "string",
            "x-web": {
              "pretty": "Remote IP range end",
              "input-type": "input"
            },
            "description": "L2TP IP address leases will end with the address specified in this field."
          },
          "port": {
            "type": "string",
            "description": "Port for binding.",
            "format": "port",
            "x-web": {
              "pretty": "Port",
              "input-type": "input"
            }
          },
          "chap": {
            "type": "string",
            "x-web": {
              "pretty": "Enable CHAP",
              "input-type": "switch"
            },
            "description": "Challenge-Handshake Authentication Protocol for L2TP."
          },
          "auth": {
            "type": "string",
            "x-web": {
              "pretty": "CHAP Secret",
              "input-type": "input",
              "depends": [
                {
                  "chap": "1"
                }
              ]
            },
            "description": "A secret used for L2TP Tunnel Authentication"
          },
          "auth_chap": {
            "type": "string",
            "x-web": {
              "pretty": "CHAP authentication",
              "input-type": "switch"
            },
            "description": "When turned on it requires CHAP authentication method to be used, when turned off it refuses CHAP authentication method",
            "format": "is_bool"
          },
          "auth_pap": {
            "type": "string",
            "x-web": {
              "pretty": "PAP authentication",
              "input-type": "switch"
            },
            "description": "When turned on it requires PAP authentication method to be used, when turned off it refuses PAP authentication method",
            "format": "is_bool"
          },
          "auth_mschap2": {
            "type": "string",
            "x-web": {
              "pretty": "MSCHAP-v2 authentication",
              "input-type": "switch"
            },
            "description": "When turned on it requires MSCHAP-v2 authentication method to be used, when turned off it refuses MSCHAP-v2 authentication method",
            "format": "is_bool"
          },
          "pppd_options": {
            "x-web": {
              "pretty": "Custom options",
              "input-type": "input"
            },
            "type": "array",
            "description": "Custom pppd (Point-to-Point Protocol Daemon) options are used to configure and manage PPP connections.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["description"]
      },
      "l2tp_server_options_id": {
        "title": "",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "x-web": {
                  "pretty": "Configuration Name",
                  "input-type": "input",
                  "unique": true
                },
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/l2tp_server_options"
          }
        ]
      },
      "l2tp_user_options": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "x-web": {
              "pretty": "Username",
              "input-type": "input",
              "unique": true
            },
            "description": "User username"
          },
          "password": {
            "type": "string",
            "x-web": {
              "pretty": "Password",
              "input-type": "input"
            },
            "description": "User password"
          },
          "remoteip": {
            "type": "string",
            "x-web": {
              "pretty": "L2TP client's IP",
              "input-type": "input"
            },
            "description": "Remote ip"
          },
          "device_name": {
            "type": "string",
            "description": "Device name",
            "readOnly": true
          }
        }
      },
      "l2tp_user_options_id": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/l2tp_user_options"
          }
        ]
      },
      "l2tp_status": {
        "title": "l2tp_status",
        "type": "object",
        "properties": {
          "rx": {
            "type": "string",
            "description": "total bytes received (server only)"
          },
          "local_ip": {
            "type": "string",
            "description": "local server ip (server only)"
          },
          "tx": {
            "type": "string",
            "description": "total bytes sent (server only)"
          },
          "start_ip": {
            "type": "string",
            "description": "L2TP IP address leases will begin from this address (server only)"
          },
          "end_ip": {
            "type": "string",
            "description": "L2TP IP address leases will end with this address (server only)"
          },
          "uptime": {
            "type": "string"
          },
          "clients_connected": {
            "type": "integer",
            "description": "connected client count (server only)"
          },
          "clients_all": {
            "type": "integer",
            "description": "configured client count (server only)"
          },
          "status": {
            "type": "string",
            "description": "0 = disconnected, 1 = connected, 2 = running, 3 = stopped, 4 = disabled",
            "enum": ["0", "1", "2", "3", "4"]
          },
          "peers": {
            "type": "array",
            "description": "peer information (server only)",
            "items": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "description": "peer username"
                },
                "remote_ip": {
                  "type": "string",
                  "description": "ip of peer"
                },
                "uptime": {
                  "type": "string"
                },
                "tx": {
                  "type": "string",
                  "description": "bytes sent"
                },
                "rx": {
                  "type": "string",
                  "description": "bytes received"
                },
                "local_ip": {
                  "type": "string",
                  "description": "local ip of device"
                },
                "device": {
                  "type": "string",
                  "description": "Physical interface name of server instance"
                }
              }
            }
          },
          "logs": {
            "type": "string",
            "description": "service logfile contents"
          },
          "username": {
            "type": "string",
            "description": "(client only)"
          },
          "server": {
            "type": "string",
            "description": "(client only)"
          },
          "device": {
            "type": "string",
            "description": "Physical interface name of client instance"
          }
        }
      }
    }
  },
