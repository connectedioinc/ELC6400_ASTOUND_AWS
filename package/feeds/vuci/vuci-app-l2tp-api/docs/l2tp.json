                        "username": "username",
                        "status": "0",
                        "logs": "Thu May  2 15:47:01 2024 daemon.info xl2tpd[4549]: Using l2tp kernel support.\n",
                        "server": "192.168.0.1"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
