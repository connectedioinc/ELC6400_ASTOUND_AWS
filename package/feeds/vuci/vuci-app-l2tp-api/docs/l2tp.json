    "/l2tp/status": {
      "get": {
        "summary": "Returns the status of all l2tp instances",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-examples": {
                    "example-1": {
                      "success": true,
                      "data": {
                        "cli": {
                          "username": "test",
                          "status": "0",
                          "server": "1.1.1.1"
                        },
                        "srv": {
                          "rx": "4124",
                          "local_ip": "192.168.0.1",
                          "tx": "2792",
                          "end_ip": "192.168.0.30",
                          "uptime": "01h 20m 30s",
                          "clients_connected": 2,
                          "status": "2",
                          "start_ip": "192.168.0.20",
                          "clients_all": 2,
                          "peers": [
                            [
                              {
                                "username": "user",
                                "remote_ip": "192.168.0.21",
                                "uptime": "00h 56m 59s",
                                "tx": "830",
                                "rx": "794",
                                "local_ip": "192.168.0.1"
                              },
                              {
                                "username": "user2",
                                "remote_ip": "192.168.0.20",
                                "uptime": "01h 20m 30s",
                                "tx": "1962",
                                "rx": "3330",
                                "local_ip": "192.168.0.1"
                              }
                            ]
                          ]
                        }
                      }
                    }
                  },
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "instance_name": {
                          "$ref": "#/components/schemas/l2tp_status"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "example": {
                    "value": {
                      "success": true,
                      "data": {
                        "server": {
                          "logs": "Using l2tp kernel support\n",
                          "local_ip": "192.168.0.1",
                          "tx": "0",
                          "end_ip": "192.168.0.30",
                          "rx": "0",
                          "clients_connected": 0,
                          "status": "2",
                          "start_ip": "192.168.0.20",
                          "clients_all": 1,
                          "peers": []
                        },
                        "client": {
                          "username": "username",
                          "status": "0",
                          "logs": "Using l2tp kernel support\n",
                          "server": "192.168.0.1"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-services-l2tp-status",
        "description": "",
        "tags": ["General"]
      },
      "x-web": {
        "menu": ["Services", "VPN", "L2TP"],
        "hw_tags": {
          "is_switch": false,
          "is_access_point": false
        },
        "name": "L2TP"
