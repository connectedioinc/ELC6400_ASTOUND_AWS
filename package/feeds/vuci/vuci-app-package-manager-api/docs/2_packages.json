    },
    "/package_manager/actions/delete_install_files": {
      "post": {
        "summary": "Deletes the uploaded package install files from the device",
        "description": "Can be used to clear up some space on the device.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200response"
          }
        },
        "tags": ["Packages"]
      },
      "x-web": {
        "menu": ["System", "Package Manager", "Package Manager"],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/package_manager/actions/install_multiple_packages": {
      "post": {
        "summary": "Starts the installation of multiple packages",
        "description": "Progress can be checked using /package_manager/all_packages/status endpoint (\"type\" field indicates the status of the package)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/multi_action_package_options"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/200response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "tags": ["Packages"]
      },
      "x-web": {
        "menu": ["System", "Package Manager", "Package Manager"],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/package_manager/actions/remove_multiple_packages": {
      "post": {
        "summary": "Starts the removal of multiple packages",
        "description": "Progress can be checked using /package_manager/all_packages/status endpoint (\"type\" field indicates the status of the package)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
