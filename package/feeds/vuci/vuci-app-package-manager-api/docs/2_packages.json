      },
      "x-web": {
        "menu": ["System", "Package Manager", "Package Manager"],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/package_manager/actions/remove_package": {
      "post": {
        "summary": "Deletes the specified package",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/remove_package_options"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/200response"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
