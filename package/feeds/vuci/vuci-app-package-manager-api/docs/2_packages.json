    "/package_manager/actions/upload_package": {
      "post": {
        "summary": "Uploads a zipped package to the device",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200UploadZipped"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "parameters": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "File to upload.",
                    "x-web": {
                      "pretty":"File to upload"
                    }
                  }
                },
                "required": ["file"]
              },
              "examples": {}
            }
          }
        },
        "tags": ["Packages"]
      },
      "x-web": {
        "menu": ["System", "Package Manager", "Package Manager"],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/package_manager/actions/install_package": {
      "post": {
        "tags": ["Packages"],
        "summary": "Installs a package",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Operation status"
                    },
                    "data": {
                      "$ref": "#/components/schemas/installed_packages_info"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/install_package_options"
                  }
                }
              }
            }
          }
        }
      },
      "x-web": {
        "menu": ["System", "Package Manager", "Package Manager"],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/package_manager/actions/update_package": {
      "post": {
        "tags": ["Packages"],
        "summary": "Upgrade a package from the server if possible",
