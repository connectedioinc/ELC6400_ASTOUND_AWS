                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "rms_proxy_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Enable RMS connection through proxy",
            "enum": ["0", "1"],
            "format": "is_bool",
            "x-web": {
              "pretty": "Enable proxy",
              "input-type": "switch"
            }
          },
          "ip": {
            "type": "string",
            "description": "Specify proxy address",
            "format": "host",
            "x-web": {
              "pretty": "Proxy address",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "socks5_port": {
            "type": "string",
            "description": "SOCKS5 proxy server port",
            "format": "port",
            "default": "1080",
            "x-web": {
              "pretty": "Proxy SOCKS5 port",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "socks5_username": {
            "type": "string",
            "description": "Specify username for SOCKS5 proxy connection. If socks5_password is present then socks5_username is required.",
            "format": "string",
            "x-web": {
              "pretty": "SOCKS5 username",
              "input-type": "input"
            }
          }
        }
      },
      "rms_proxy_request_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "socks5_password": {
                "type": "string",
                "description": "Specify password for SOCKS5 proxy connection. If socks5_username is present then socks5_password is required.",
                "format": "string",
                "x-web": {
                  "pretty": "SOCKS5 password",
                  "input-type": "input"
                }
              }
            }
          },
