  "components": {
    "schemas": {
      "bfd_intervals": {
        "type": "object",
        "properties": {
          "receive_interval": {
            "x-web": {
              "pretty": "Receive interval",
              "input-type": "input"
            },
            "type": "string",
            "format": "irange(10, 4294967)",
            "description": "Configures the minimum interval in milliseconds that this system is capable of receiving control packets."
          },
          "transmit_interval": {
            "x-web": {
              "pretty": "Transmit interval",
              "input-type": "input"
            },
            "type": "string",
            "format": "irange(10, 4294967)",
            "description": "The minimum transmission interval, in milliseconds (with reduced jitter), that this system aims to use for sending BFD control packets."
          }
        }
      },
      "bfd_peers": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "string",
                "description": "Enables or disables the peer.",
                "enum": ["1", "0"],
                "x-web": {
                  "pretty": "Enable",
                  "input-type": "switch"
                }
              },
              "ip": {
                "x-web": {
                  "pretty": "IP address",
                  "input-type": "input"
                },
                "type": "string",
                "format": "ipaddr",
                "description": "Remote IP address of the device (peer) with which BFD establishes a session. IP address identifies the neighboring router or system that BFD will monitor for liveliness."
              },
              "multihop_ip": {
                "x-web": {
                  "pretty": "IP address",
                  "input-type": "input"
                },
                "type": "string",
                "format": "ipaddr",
                "description": "Tells the BFD daemon that we should expect packets with TTL less than 254 and to listen on the multihop port. Requires to specify which IP address should be used as the source of the BFD packets."
              },
              "detect_multiplier": {
                "x-web": {
                  "pretty": "Detect multiplier",
                  "input-type": "input"
                },
                "type": "string",
                "format": "irange(1, 255)",
                "description": "Configures the detection multiplier to determine packet loss. The remote transmission interval will be multiplied by this value to determine the connection loss detection timer."
              },
              "profile": {
                "x-web": {
                  "pretty": "Profile",
                  "input-type": "input"
                },
                "type": "string",
                "description": "Configure peer to use the profile configurations. Profile configurations can be overridden on a peer basis by specifying non-default parameters in peer configuration node."
              }
            },
            "required": ["ip"]
          },
          {
            "$ref": "#/components/schemas/bfd_intervals"
          },
          {
            "type": "object",
            "properties": {
              "passive_mode": {
                "type": "string",
                "description": "Mark session as passive: a passive session will not attempt to start the connection and will wait for control packets from peer before it begins replying.",
                "enum": ["1", "0"],
                "x-web": {
                  "pretty": "Passive mode",
                  "input-type": "switch"
                }
              }
            }
          }
        ]
      },
      "bfd_peers_status": {
        "description": "BFD peers status",
        "type": "object",
        "properties": {
          "peer": {
            "type": "string",
            "description": "The remote peer's IP address."
          },
          "status": {
            "type": "string",
            "description": "The current BFD session state as seen by the transmitting system."
          },
          "diagnostic": {
            "type": "string",
            "description": "A diagnostic message specifying the local system's reason for the last change in session state."
          },
          "detect_multiplier": {
            "type": "number",
            "description": "The remote transmission interval that will be multiplied by this value to determine the connection loss detection timer."
          },
          "remote_transmit_interval": {
            "type": "number",
            "description": "The transmission interval in milliseconds at which the remote peer is sending BFD control packets."
          },
          "remote_receive_interval": {
            "type": "number",
            "description": "The minimum interval in milliseconds that the remote peer is capable of receiving control packets."
          },
          "uptime": {
            "type": "number",
            "description": "The total cumulative duration in seconds that the BFD session has been in the 'Up' state."
          },
          "downtime": {
            "type": "number",
            "description": "The total cumulative duration in seconds that the BFD session has been in the 'Down' state."
          },
          "session_up": {
            "type": "number",
            "description": "The number of times the BFD session transitioned to the 'Up' state."
          },
          "session_down": {
            "type": "number",
            "description": "The number of times the BFD session transitioned to the 'Down' state."
          }
        }
      },
      "bfd_peers_req_body_multi": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
