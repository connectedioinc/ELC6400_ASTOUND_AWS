{
  "openapi": "3.0.0",
  "tags": [
    {
      "name": "Server nodes"
    }
  ],
  "paths": {
    "/opcua/destination_server/nodes/config": {
      "get": {
        "tags": [
          "Server nodes"
        ],
        "summary": "Returns all OPC UA server node configurations.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200OpcuaServerNodeMulti"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "post": {
        "tags": [
          "Server nodes"
        ],
        "summary": "Creates a OPC UA server node configuration. Data sources can be found using /universal_gateway/options endpoint",
        "responses": {
          "201": {
            "$ref": "#/components/responses/200OpcuaServerNode"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/opcua_node_single_options"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Server nodes"
        ],
        "summary": "Updates specified OPC UA server node configurations. Data sources can be found using /universal_gateway/options endpoint",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200OpcuaServerNodeMulti"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/opcua_node_options"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Server nodes"
        ],
        "summary": "Deletes specified OPC UA server node configurations.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200deleted_multi"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "description": "Array of section objects",
                    "items": {
                      "type": "string",
                      "description": "Section id"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "x-web": {
        "name": "OPC UA",
        "menu": [
          "Services",
          "OPC UA",
          "Server",
          "Data Sources"
        ],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/opcua/destination_server/nodes/config/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "OPC UA server node Configuration identifier (ID)"
        }
      ],
      "get": {
        "tags": [
          "Server nodes"
        ],
        "summary": "Returns the specified OPC UA server node configuration.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200OpcuaServerNode"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "tags": [
          "Server nodes"
        ],
        "summary": "Updates the specified OPC UA server node configuration. Data sources can be found using /universal_gateway/options endpoint",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200OpcuaServerNode"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/opcua_node_single_options"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Server nodes"
        ],
        "summary": "Deletes specified OPC UA server node configuration.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200deleted"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "OPC UA server node Configuration identifier (ID)"
          }
        ]
      },
      "x-web": {
        "name": "OPC UA",
        "menu": [
          "Services",
          "OPC UA",
          "Server",
          "Data Sources"
        ],
        "hw_tags": {
          "is_access_point": false
        }
      }
    }
