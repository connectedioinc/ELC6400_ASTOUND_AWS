            "$ref": "#/components/schemas/modbus_serial_server_register_single_options"
          }
        ]
      },
      "modbus_serial_server_register_get_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Modbus Serial Server Register Configuration identifier (ID)."
              }
            }
          },
          {
            "$ref": "#/components/schemas/modbus_serial_server_register_single_options"
          }
        ]
