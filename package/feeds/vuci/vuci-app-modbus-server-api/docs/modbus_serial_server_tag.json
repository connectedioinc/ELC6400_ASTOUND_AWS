    "schemas": {
      "modbus_serial_server_register_single_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Enable/disable Modbus Serial Server Register.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            }
          },
          "tag_name": {
            "type": "string",
            "description": "Display name of configuration.",
            "format": "uciname",
            "maxLength": 128,
            "x-web": {
              "pretty": "Register name",
              "input-type": "input",
              "unique": true
            }
          },
          "tag_source": {
            "type": "string",
            "description": "Client service name.",
            "enum": [
              "modbus_client",
              "dnp3_client"
            ],
            "x-web": {
              "pretty": "Register source",
              "input-type": "select",
              "enum-pretty": {
                "modbus_client": "Modbus Client",
                "dnp3_client": "DNP3 Client"
              }
            }
          },
          "tag_id": {
            "type": "string",
            "description": "Value which will be written or read.",
            "x-web": {
              "pretty": "Register value",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "tag_type": {
            "type": "string",
            "description": "Value data type.",
            "enum": [
              "string",
              "binary",
              "bool",
              "int8",
              "uint8",
              "int16",
              "uint16",
              "int32",
              "uint32",
              "int64",
              "uint64",
              "float32",
              "float64"
            ],
            "x-web": {
              "pretty": "Register type",
              "input-type": "select",
              "enum-pretty": {
                "string": "String",
                "binary": "Binary",
                "bool": "Bool",
                "int8": "INT8",
                "uint8": "UINT8",
                "int16": "INT16",
                "uint16": "UINT16",
                "int32": "INT32",
                "uint32": "UINT32",
                "int64": "INT64",
                "uint64": "UINT64",
                "float32": "FLOAT32",
                "float64": "FLOAT64"
              }
            }
          },
          "tag_size": {
            "type": "string",
            "description": "Value size in bytes.",
            "format": "uinteger",
            "x-web": {
              "pretty": "Register size",
              "input-type": "input",
              "depends": [
                {
                  "tag_type": "string"
                },
                {
                  "tag_type": "binary"
                }
              ],
              "require-depends": [
                {
                  "tag_type": "string"
                },
                {
                  "tag_type": "binary"
                }
              ]
            }
          },
          "tag_permissions": {
            "type": "string",
            "description": "Register read/write permissions",
            "enum": [
              "r",
              "w",
              "rw"
            ],
            "x-web": {
              "pretty": "Register permissions",
              "input-type": "input",
              "enum-pretty": {
                "r": "Read-Only",
                "w": "Write-Only",
                "rw": "Read-Write"
              }
            }
          },
          "tag_start": {
            "type": "string",
            "description": "Value subset start index.",
            "format": "irange(0, 65535)",
            "x-web": {
              "pretty": "Value start index",
              "input-type": "input"
            }
          },
          "tag_count": {
            "type": "string",
            "description": "Value subset count.",
            "format": "irange(1, 65536)",
            "x-web": {
              "pretty": "Value subset count",
              "input-type": "input"
            }
          },
          "modbus_dev_config": {
            "type": "string",
            "description": "Modbus Server Configuration identifier (ID).",
            "x-web": {
              "pretty": "Modbus Serial Server",
              "input-type": "input"
            }
          },
          "modbus_type": {
            "type": "string",
            "description": "Modbus function type.",
            "enum": [
              "1",
              "2",
              "3",
              "4"
            ],
            "x-web": {
              "pretty": "Modbus data type",
              "input-type": "select",
              "enum-pretty": {
                "1": "Coils (1)",
                "2": "Input coils (2)",
                "3": "Holding registers (3)",
                "4": "Input registers (4)"
              }
            }
          },
          "modbus_reg_num": {
            "type": "string",
            "description": "Start register number.",
            "x-web": {
              "pretty": "Modbus register number",
              "input-type": "input"
            }
          }
        },
        "required": [
          "modbus_dev_config"
        ]
