{
  "openapi": "3.0.0",
  "info": {
    "title": "Password policy",
    "version": "1.0",
    "description": "Password policy API documentation"
  },
  "tags": [
    {
      "name": "General"
    }
  ],
  "paths": {
    "/password_policy/config": {
      "get": {
        "tags": ["General"],
        "summary": "Returns password policy configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200PasswordPolicy"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "tags": ["General"],
        "summary": "Updates password policy configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200PasswordPolicy"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "description": "Array of section objects",
                    "items": {
                      "$ref": "#/components/schemas/password_policy_options"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "x-web": {
        "menu": ["System", "Administration", "User Settings"]
      }
    },
    "/password_policy/config/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Configuration ID"
        }
      ],
      "get": {
        "tags": ["General"],
        "summary": "Returns password policy configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200PasswordPolicySingle"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configuration ID"
          },
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "tags": ["General"],
        "summary": "Updates password policy configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200PasswordPolicySingle"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/password_policy_single_options"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configuration ID"
          }
        ]
      },
      "x-web": {
        "menu": ["System", "Administration", "User Settings"]
      }
    }
  },
  "components": {
    "schemas": {
      "password_policy_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Configuration ID"
              }
            }
          },
          {
            "$ref": "#/components/schemas/password_policy_single_options"
          }
        ]
      },
      "password_policy_single_options": {
        "type": "object",
        "properties": {
          "password_length": {
            "x-web": {
              "pretty": "Password length",
              "input-type": "input"
            },
            "type": "string",
            "description": "Minimum length of the password",
            "format": "irange(8, 64)"
          },
          "require_digits": {
            "x-web": {
              "pretty": "Digits",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Password must contain at least one digit",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "require_lower_upper": {
            "x-web": {
              "pretty": "Upper / lower case characters",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Password must contain both upper and lower case letters",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "require_special": {
            "x-web": {
              "pretty": "Special characters",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Password must contain at least one special character",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "password_lifetime": {
            "x-web": {
              "pretty": "Password expiration",
              "input-type": "input"
            },
            "type": "string",
            "description": "Days the password is valid for",
            "format": "irange(0, 365)"
          },
          "current_days_left": {
            "type": "string",
            "description": "Current user password expiration days remaining",
            "readOnly": true
          }
        }
      }
    },
    "responses": {
      "200PasswordPolicy": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/password_policy_options"
                  }
                }
              }
            }
          }
        }
      },
      "200PasswordPolicySingle": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/password_policy_options"
                }
              }
            }
          }
        }
      }
    }
  }
}
