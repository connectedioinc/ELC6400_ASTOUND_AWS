{
  "openapi": "3.0.0",
  "tags": [
    {
      "name": "TCP Client"
    }
  ],
  "paths": {
    "/dnp3/tcp/config": {
      "get": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Returns all TCP Client configuration",
        "description": "Returns all configuration with their parameters form TCP Client configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200DNP3TCPMulti"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "post": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Creates TCP Client configuration",
        "responses": {
          "201": {
            "$ref": "#/components/responses/200DNP3TCP"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter configuration",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/DNP3_tcp_options"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Updates specified TCP Client configurations",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200DNP3TCPMulti"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "requestBody": {
          "description": "Parameter configuration",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "description": "Array of configuration objects",
                    "items": {
                      "allOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "$ref": "#/components/schemas/DNP3_tcp_options"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Deletes specified TCP Client configurations",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200deleted_multi"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "requestBody": {
          "description": "Parameter configuration",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "description": "Array of configuration objects",
                    "items": {
                      "type": "string",
                      "description": "configuration id"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "x-web": {
        "name": "DNP3",
        "menu": [
          "Services",
          "DNP3",
          "DNP3"
        ],
        "hw_tags": {
          "is_access_point": false,
          "is_switch": false
        }
      }
    },
    "/dnp3/tcp/config/{id}": {
      "get": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Returns specified TCP Client configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200DNP3TCP"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configuration DNP3 identifier (ID)"
          },
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Updates specified TCP Client configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200DNP3TCP"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configuration TCP Client identifier (ID)"
          }
        ],
        "requestBody": {
          "description": "Parameter configuration",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/DNP3_tcp_options"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Deletes specified TCP Client configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200deleted"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configuration TCP Client identifier (ID)"
          }
        ]
      },
      "x-web": {
        "name": "DNP3",
        "menu": [
          "Services",
          "DNP3",
          "DNP3"
        ],
        "hw_tags": {
          "is_access_point": false,
          "is_switch": false
        }
      }
    },
    "/dnp3/tcp/actions/test_request": {
      "post": {
        "tags": [
          "DNP3"
        ],
        "summary": "Test request configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200RequestActionTCP"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter configuration",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/DNP3_tcp_test_request_options"
                  }
                },
                "x-examples": {
                  "example-1": {
                    "data": {
                      "local_addr": "65519",
                      "timeout": "0",
                      "ip": "1.1.1.1",
                      "remote_addr": "65519",
                      "count": "30",
                      "port": "666",
                      "name": "piotras",
                      "data_type": "3",
                      "index": "20"
                    }
                  }
                }
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        }
      },
      "x-web": {
        "name": "DNP3",
        "hidden": true,
        "menu": [
          "Services",
          "DNP3",
          "DNP3"
        ],
        "hw_tags": {
          "is_access_point": false,
          "is_switch": false
        }
      }
    },
    "/dnp3/tcp/status": {
      "get": {
        "tags": [
          "TCP Client"
        ],
        "summary": "Returns TCP Client status",
        "description": "Returns status data from Client ubus call",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200DNP3TCPStatus"
          }
        }
      },
      "x-web": {
        "name": "DNP3",
        "menu": [
          "Services",
          "DNP3",
          "DNP3"
        ],
        "hw_tags": {
          "is_access_point": false,
          "is_switch": false
        }
      }
    }
  },
  "components": {
    "responses": {
      "200RequestActionTCP": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "response": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "200DNP3TCP": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/dnp3_tcp_options_multi"
                }
              }
            }
          }
        }
      },
      "200DNP3TCPMulti": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of configuration objects",
                  "items": {
                    "$ref": "#/components/schemas/dnp3_tcp_options_multi"
                  }
                }
              }
            }
          }
        }
      },
      "200DNP3TCPStatus": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/dnp3_tcp_status_options"
                }
              },
              "required": [
                "success",
                "data"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "dnp3_tcp_options_multi": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "DNP3 client configuration identifier (ID)."
              }
            },
            "required": [
              "id"
            ]
          },
          {
            "$ref": "#/components/schemas/DNP3_tcp_options"
          }
        ]
      },
      "DNP3_tcp_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Check to enable this TCP client configuration",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of the TCP client",
            "maxLength": 32,
            "x-web": {
              "pretty": "Name",
              "input-type": "input",
              "unique": true,
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "local_addr": {
            "type": "string",
            "description": "Client Link-Layer address",
            "format": "irange(0, 65519)",
            "x-web": {
              "pretty": "Local address",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "remote_addr": {
            "type": "string",
            "description": "Outstation Link-Layer address",
            "format": "irange(0, 65519)",
            "x-web": {
              "pretty": "Remote address",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "integrity_period": {
            "type": "string",
            "description": "Period for sending data requests",
            "format": "irange(1, 60)",
            "default": "60",
            "x-web": {
              "pretty": "Period",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "timeout": {
            "type": "string",
            "description": "Request timeout",
            "format": "irange(1, 60)",
            "x-web": {
              "pretty": "Timeout",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "save_to_flash": {
            "type": "string",
            "description": "Check to enable saving to flash. Enabling this option might cause wear on the flash memory.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Save to flash",
              "input-type": "switch"
            }
          },
          "ip": {
            "type": "string",
            "description": "DNP3 Outstation IP address",
            "format": "ipaddr",
            "x-web": {
              "pretty": "IP address",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "port": {
            "type": "string",
            "description": "DNP3 Outstation Port",
            "format": "port",
            "x-web": {
              "pretty": "Port",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          }
        }
      },
      "DNP3_tcp_test_request_options": {
        "type": "object",
        "properties": {
          "local_addr": {
            "type": "string",
            "description": "Client Link-Layer address",
            "format": "irange(0, 65519)"
          },
          "timeout": {
            "type": "string",
            "description": "Request timeout",
            "format": "irange(1, 60)"
          },
          "ip": {
            "type": "string",
            "description": "DNP3 Outstation IP address",
            "format": "ipaddr"
          },
          "remote_addr": {
            "type": "string",
            "description": "Outstation Link-Layer address",
            "format": "irange(0, 65519)"
          },
          "count": {
            "type": "string",
            "description": "End index of the data subarray",
            "format": "irange(0, 65535)"
          },
          "port": {
            "type": "string",
            "description": "DNP3 Outstation Port",
            "format": "port"
          },
          "data_type": {
            "type": "string",
            "description": "Data object group of the requested index(-es)"
          },
          "index": {
            "type": "string",
            "description": "Start index of the data subarray",
            "format": "irange(0, 65535)"
          }
        }
      },
      "dnp3_tcp_status_options": {
        "title": "dnp3_tcp_status_options",
        "type": "object",
        "properties": {
          "uptime": {
            "type": "integer",
            "description": "Uptime of the application",
            "x-web": {
              "pretty": "Uptime"
            }
          },
          "clients": {
            "type": "array",
            "description": "Array of DNP3 TCP Clients status objects",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "DNP3 TCP Client configuration identifier (ID)."
                },
                "connected": {
                  "type": "boolean",
                  "description": "TCP Client connection"
                },
                "successful_request_count": {
                  "type": "integer",
                  "description": "Number of successful requests"
                },
                "failed_request_count": {
                  "type": "integer",
                  "description": "Number of failed requests"
                }
              },
              "required": [
                "id",
                "connected",
                "successful_request_count",
                "failed_request_count"
              ]
            }
          }
        },
        "required": [
          "uptime",
          "clients"
        ]
      }
    }
  }
}
