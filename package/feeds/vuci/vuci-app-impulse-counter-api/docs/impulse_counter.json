  "components": {
    "responses": {
      "200impulse_counter_global": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/impulse_counter_global_options"
                }
              },
              "required": [
                "success",
                "data"
              ]
            }
          }
        }
      },
      "200impulse_counter_status": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "string",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/impulse_counter_status_options"
                }
              },
              "required": [
                "success",
                "data"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "impulse_counter_global_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Turns the Impulse counter service on or off. This field has to be enabled in order to use any Impulse counter related functions.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Enabled",
              "input-type": "switch"
            }
          },
          "count_store_duration": {
            "type": "string",
            "description": "Set the count store duration to define how many days the impulse counts are retained before being reset or archived.",
            "format": "irange(3600, 3456000)",
            "x-web": {
              "pretty": "Count store duration",
              "input-type": "input"
            }
          }
        },
        "required": [
          "enabled",
          "count_store_duration",
          "flash_storage_period"
        ]
      },
      "impulse_counter_status_options": {
        "description": "Impulse counter status",
        "type": "object",
        "properties": {
          "state": {
            "type": "boolean",
            "description": "Impulse counter application state"
          }
        }
      }
    }
