  "components": {
    "schemas": {
      "eoip_options": {
        "title": "eoip_options",
        "description": "",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "x-web": {
                  "pretty": "Configuration ID",
                  "unique": true,
                  "input-type": "input"
                },
                "type": "string",
                "description": "EoIP configuration identifier (ID)."
              }
            }
          },
          {
            "$ref": "#/components/schemas/eoip_single_options"
          }
        ]
      },
      "eoip_single_options": {
        "title": "eoip_single_options",
        "type": "object",
        "description": "",
        "properties": {
          "enabled": {
            "x-web": {
              "pretty": "Enable configuration",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Enable current configuration.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "name": {
            "x-web": {
              "pretty": "Name",
              "input-type": "input"
            },
            "type": "string",
            "description": "Name of the EoIP instance.",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_ ]+"
          },
          "tun_id": {
            "x-web": {
              "pretty": "Tunnel ID",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            },
            "type": "string",
            "description": "Unique tunnel identifier, which must match other side of the tunnel.",
            "format": "irange(1, 65536)"
          },
          "local_ip": {
            "x-web": {
              "pretty": "Local IP",
              "input-type": "input"
            },
            "type": "string",
            "description": "The parameter specifies the local IP address used as the source for sending traffic through a tunnel.",
            "format": "ipaddr"
          },
          "dynamic": {
            "x-web": {
              "pretty": "Dynamic",
              "input-type": "switch"
            },
            "type": "string",
            "format": "is_bool",
            "enum": ["0", "1"],
            "description": "Allow the connection. If you enable it, be aware that there is no authorization and it is not secure. Avoid using this feature on a public IP or a network where you do not have full control over all hosts."
          },
          "remote_ip": {
            "x-web": {
              "pretty": "Remote IP",
              "input-type": "input",
              "depends": [
                {
                  "dynamic": "1"
                }
              ]
            },
            "type": "string",
            "description": "The parameter specifies the IP address of the remote endpoint that the tunnel will connect to.",
            "format": "ipaddr"
          },
          "to_bridge": {
            "x-web": {
              "pretty": "Bridge",
              "input-type": "input"
            },
            "type": "string",
            "description": "Assign a EoIP interface to a bridge."
          },
          "use_ipv6": {
            "x-web": {
              "pretty": "Use IPv6",
              "input-type": "switch"
            },
            "type": "string",
            "format": "is_bool",
            "enum": ["0", "1"],
            "description": "Use IPv6 address to create a tunnel"
          }
        },
        "required": ["name"]
      }
    },
    "responses": {
      "200EoIP": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "data": {
                  "$ref": "#/components/schemas/eoip_options"
                }
              }
            }
          }
        }
      },
      "200EoIPMulti": {
        "description": "Returns configurations",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/eoip_options"
                  }
                }
              }
            }
          }
        }
      }
    }
