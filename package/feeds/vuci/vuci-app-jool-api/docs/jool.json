  "components": {
    "schemas": {
      "jool_general": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Turns on NAT64 service.",
            "enum": ["1", "0"],
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            }
          },
          "interface": {
            "type": "string",
            "description": "IPv6 interface which will be used for the translation.",
            "x-web": {
              "pretty": "IPv6 interface",
              "input-type": "input"
            }
          }
        }
      },
      "jool_rules": {
        "type": "object",
        "properties": {
          "enabled": {
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Turns the rule on or off."
          },
          "name": {
            "x-web": {
              "pretty": "Name",
              "input-type": "input",
              "unique": true
            },
            "type": "string",
            "description": "Name of the rule. This is only used for easier management purposes."
          },
          "proto": {
            "x-web": {
              "pretty": "Protocol",
              "input-type": "input"
            },
            "type": "array",
            "description": "Only match traffic using the given internet communication protocol.",
            "items": {
              "type": "string"
            }
          },
          "src": {
            "x-web": {
              "pretty": "Source zone",
              "input-type": "input"
            },
            "type": "string",
            "description": "Only match traffic coming to the given firewall zone."
          },
          "src_ipv6": {
            "x-web": {
              "pretty": "Source IPv6 address",
              "input-type": "input"
            },
            "description": "Source IPv6 address or network segment from which the traffic will be translated.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "src_port": {
            "x-web": {
              "pretty": "Source port",
              "input-type": "input",
              "depends": [
                {
                  "proto": "tcp"
                },
                {
                  "proto": "udp"
                }
              ]
            },
            "description": "Only match traffic coming from the given port.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dest_ipv6": {
            "x-web": {
              "pretty": "Destination IPv6 address",
              "input-type": "input"
            },
            "type": "array",
            "description": "Destination IPv6 address or network segment to which the traffic will be translated.",
            "items": {
              "type": "string"
            }
          },
          "dest_ipv4": {
            "x-web": {
              "pretty": "Destination IPv4 address",
              "input-type": "input"
            },
            "description": "Destination IPv4 address or network segment to which the traffic will be translated.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dest_port": {
            "x-web": {
              "pretty": "Destination port",
              "input-type": "input",
              "depends": [
                {
                  "proto": "tcp"
                },
                {
                  "proto": "udp"
                }
              ]
            },
            "description": "Only match traffic being forwarded to the given port.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "jool_req_body_multi": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "type": "object",
