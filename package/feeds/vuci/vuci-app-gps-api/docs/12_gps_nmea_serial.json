              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/gps_nmea_serial_port_options"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
