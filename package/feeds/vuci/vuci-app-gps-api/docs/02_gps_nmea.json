  "components": {
    "schemas": {
      "gps_nmea_single_options": {
        "description": "This section is used to configure NMEA forwarding settings",
        "type": "object",
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Turns NMEA forwarding on or off.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Enabled",
              "input-type": "switch",
              "group": "Forwarding"
            }
          },
          "host_info": {
            "type": "array",
            "description": "Specify host info, Array of addresses, ports and protocols is accepted for host configuration. E.g 192.168.1.1;80;tcp, 224.0.0.0;8000;udp;lan.",
            "items": {
              "type": "string"
            },
            "x-web": {
              "pretty": "Host info",
              "input-type": "input",
              "group": "Forwarding"
            }
          },
          "hostname": {
            "type": "string",
            "description": "IP address or hostname of the server to which NMEA data will be forwarded.",
            "format": "host",
            "deprecated": true,
            "x-web": {
              "pretty": "Hostname",
              "input-type": "input",
              "group": "Forwarding"
            }
          },
          "proto": {
            "type": "string",
            "description": "Communication protocol used for NMEA sentence forwarding.",
            "deprecated": true,
            "enum": [
              "tcp",
              "udp"
            ],
            "x-web": {
              "pretty": "Protocol",
              "enum-pretty": {
                "tcp": "TCP",
                "udp": "UDP"
              },
              "input-type": "input",
              "group": "Forwarding"
            }
          },
          "port": {
            "type": "string",
            "description": "TCP/UDP port number of the server.",
            "format": "port",
            "deprecated": true,
            "x-web": {
              "pretty": "Port",
              "input-type": "input",
              "group": "Forwarding"
            }
          },
          "con_contain": {
            "type": "string",
            "description": "Contain active session with a remote server",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Contain connection",
              "input-type": "switch",
              "group": "Forwarding"
            }
          },
          "send_prefix": {
            "type": "string",
            "description": "Prefix is added to the NMEA sentence before it is transmitted. Example: 0012345567_$GPRMC....",
            "maxLength": 64,
            "x-web": {
              "pretty": "Select prefix",
              "input-type": "input",
              "group": "Forwarding"
            }
          },
          "type": {
            "type": "string",
            "description": "Set which type of memory will be used for storing NMEA forwarding cache.",
            "enum": [
              "ram",
              "flash"
            ],
            "x-web": {
              "pretty": "Save cache in",
              "enum-pretty": {
                "ram": "RAM memory",
                "flash": "Flash memory"
              },
              "input-type": "select",
              "group": "Forwarding"
            }
          },
          "sentences_max": {
            "type": "string",
            "description": "Maximum amount of NMEA sentences that will be saved in the cache before older entries are replaced by new ones.",
            "format": "uinteger",
            "x-web": {
              "pretty": "Maximum sentences",
              "input-type": "input",
              "group": "Forwarding"
            }
          },
          "location": {
            "type": "string",
            "description": "Location of the file where NMEA forwarding cache information will be stored.",
            "maxLength": 4095,
            "x-web": {
              "pretty": "File",
              "input-type": "input",
              "depends": [
                {
                  "type": "flash"
                }
              ],
              "group": "Forwarding"
            }
          },
          "collecting_enabled": {
            "type": "string",
            "description": "Turns NMEA sentence collecting on or off.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Enabled",
              "input-type": "switch",
              "group": "Collecting"
            }
          },
          "collecting_location": {
            "type": "string",
            "description": "Location of the file where collected NMEA sentences will be stored.",
            "maxLength": 4095,
            "x-web": {
              "pretty": "File",
              "input-type": "input",
              "depends": [
                {
                  "collecting_enabled": "1"
                }
              ],
              "group": "Collecting"
            }
          },
          "serial_enabled": {
            "type": "string",
            "description": "Turns NMEA serial forwarding on or off.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Enabled",
              "input-type": "switch",
              "hw_tags": {
                "serial_usb": true
              },
              "group": "Forwarding"
            }
          },
          "serial_send_prefix": {
            "type": "string",
            "description": "Prefix is added to the NMEA sentence before it is transmitted. Example: 0012345567_$GPRMC....",
            "maxLength": 64,
            "x-web": {
              "pretty": "Select prefix",
              "input-type": "input",
              "hw_tags": {
                "serial_usb": true
              },
              "group": "Forwarding"
            }
          }
        },
        "required": [
          "enabled",
          "hostname",
          "proto",
          "port",
          "con_contain",
          "type",
          "sentences_max",
          "location",
          "collecting_enabled",
          "collecting_location"
        ]
      },
      "gps_nmea_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          },
          {
            "$ref": "#/components/schemas/gps_nmea_single_options"
          }
        ]
      },
      "gps_nmea_status": {
        "title": "gps_nmea_status",
        "type": "object",
        "properties": {
          "uptime": {
            "type": "integer",
            "description": "Uptime of the application",
            "x-web": {
              "pretty": "Uptime"
            }
          },
          "hosts": {
            "type": "array",
            "description": "Array of hosts",
            "items": {
              "type": "object",
              "properties": {
                "hostname": {
                  "type": "string",
                  "description": "IP address or hostname of the server to which NMEA data will be forwarded"
                },
                "port": {
                  "type": "string",
                  "description": "TCP/UDP port number of the server"
                },
                "protocol": {
                  "type": "string",
                  "description": "Communication protocol used for NMEA sentence forwarding"
                },
                "interface": {
                  "type": "string",
                  "description": "Network interface used for multicast UDP data sending"
                },
                "connected": {
                  "type": "boolean",
                  "description": "NMEA connection to server"
                },
                "forwarded_sentence_count": {
                  "type": "integer",
                  "description": "Number of sentences that have been sent/forwarded to server"
                }
              },
              "required": [
                "hostname",
                "port",
                "protocol",
                "connected",
                "forwarded_sentence_count"
              ]
            }
          },
          "serials": {
            "type": "array",
            "description": "Array of serial ports",
            "items": {
              "type": "object",
              "properties": {
                "section_id": {
                  "type": "string",
                  "description": "GPS NMEA serial port configuration identifier (ID)"
                },
                "forwarded_sentence_count": {
                  "type": "integer",
                  "description": "Number of sentences that have been sent/forwarded to serial device"
                }
              },
              "required": [
                "section_id",
                "forwarded_sentence_count"
              ]
            }
          }
        },
        "required": [
          "uptime",
          "hosts"
        ]
      }
    },
    "responses": {
      "200gps_nmea": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/gps_nmea_options"
                }
              }
            }
          }
        }
      },
      "200gps_nmea_multi": {
        "description": "Returns configurations",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/gps_nmea_options"
                  }
                }
              }
            }
          }
        }
      },
      "200gps_nmea_status": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/gps_nmea_status"
                }
              },
              "required": [
                "success",
                "data"
              ]
            }
          }
        }
      }
    }
  }
}
