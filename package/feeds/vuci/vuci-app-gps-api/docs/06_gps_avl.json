  "components": {
    "schemas": {
      "gps_avl_single_options": {
        "description": "This section is used to configure the main data sending parameters to an AVL server.",
        "type": "object",
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Turns data sending to an AVL server on or off.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            }
          },
          "send_retry": {
            "type": "string",
            "description": "In case of a failed attempt, retry to send the same data to server later (Retry until successful)",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Retry on fail",
              "input-type": "switch"
            }
          },
          "host_info": {
            "type": "array",
            "description": "Specify host info, Array of addresses, ports and protocols is accepted for host configuration. E.g 192.168.1.1;80;tcp.",
            "items": {
              "type": "string"
            },
            "x-web": {
              "pretty": "Host info",
              "input-type": "input"
            }
          },
          "hostname": {
            "type": "string",
            "description": "Hostname of the remote server",
            "deprecated": true,
            "x-web": {
              "pretty": "Hostname",
              "input-type": "input"
            }
          },
          "proto": {
            "type": "string",
            "description": "Protocol to be used for sending AVL to the remote server",
            "deprecated": true,
            "enum": [
              "tcp",
              "udp"
            ],
            "x-web": {
              "pretty": "Protocol",
              "enum-pretty": {
                "tcp": "TCP",
                "udp": "UDP"
              },
              "input-type": "select"
            }
          },
          "port": {
            "type": "string",
            "description": "Port of the remote server",
            "deprecated": true,
            "x-web": {
              "pretty": "Port",
              "input-type": "input"
            }
          },
          "con_cont": {
            "type": "string",
            "description": "Set to handle each AVL packet iteration as a new connection",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Don't contain connection",
              "input-type": "switch"
            }
          },
          "static_navigation": {
            "type": "string",
            "description": "Set to stop collecting NMEA data if object is stationary.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Static navigation",
              "input-type": "switch"
            }
          },
          "send_empty": {
            "type": "string",
            "description": "Set to send AVL packet with zeros for latitude and longitude if no new data is received within the specified timeout period.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Send empty",
              "input-type": "switch"
            }
          },
          "timeout_empty": {
            "type": "string",
            "description": "Set the duration in seconds to wait for new data before beginning to collect zeroed messages.",
            "format": "irange(2,86400)",
            "x-web": {
              "pretty": "No signal timeout",
              "input-type": "input",
              "depends": [
                {
                  "send_empty": "1"
                }
              ]
            }
          }
        },
        "required": [
          "enabled",
          "send_retry",
          "hostname",
          "proto",
          "port",
          "con_cont",
          "static_navigation"
        ]
      },
      "gps_avl_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          },
          {
            "$ref": "#/components/schemas/gps_avl_single_options"
          }
        ]
      },
      "gps_avl_status": {
        "title": "gps_avl_status",
        "type": "object",
        "properties": {
          "uptime": {
            "type": "integer",
            "description": "Uptime of the application",
            "x-web": {
              "pretty": "Uptime"
            }
          },
          "active_rule": {
            "type": "string",
            "x-web": {
              "pretty": "Active rule"
            }
          },
          "current_distance": {
            "type": "number",
            "x-web": {
              "pretty": "Current distance"
            }
          },
          "current_angle": {
            "type": "number",
            "x-web": {
              "pretty": "Current angle"
            }
          },
          "current_accuracy": {
            "type": "number",
            "x-web": {
              "pretty": "Current accuracy"
            }
          },
          "hosts": {
            "type": "array",
            "description": "Array of hosts",
            "items": {
              "type": "object",
              "properties": {
                "hostname": {
                  "type": "string",
                  "description": "Hostname of the remote server"
                },
                "port": {
                  "type": "string",
                  "description": "Port of the remote server"
                },
                "protocol": {
                  "type": "string",
                  "description": "Protocol to be used for sending AVL to the remote server"
                },
                "connected": {
                  "type": "boolean",
                  "description": "Is connection active"
                },
                "successful_count": {
                  "type": "integer",
                  "description": "Number of records that were sent successfully"
                },
                "failed_count": {
                  "type": "integer",
                  "description": "Number of records that failed to send"
                },
                "collected_record_count": {
                  "type": "integer",
                  "description": "Number of packets that will be saved when the next tmie packet is sent"
                },
                "time_since_last_record_sent": {
                  "type": "integer",
                  "description": "Time that has passed since the last record has been sent"
                }
              },
              "required": [
                "hostname",
                "port",
                "protocol",
                "successful_count",
                "failed_count",
                "collected_record_count"
              ]
            }
          }
        },
        "required": [
          "uptime",
          "hosts"
        ]
      }
    },
    "responses": {
      "200gps_avl": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/gps_avl_options"
                }
              }
            }
          }
        }
      },
      "200gps_avl_multi": {
        "description": "Returns configurations",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/gps_avl_options"
                  }
                }
              }
            }
          }
        }
      },
      "200gps_avl_status": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/gps_avl_status"
                }
              },
              "required": [
                "success",
                "data"
              ]
            }
          }
        }
      }
    }
  }
}
