      "x-web": {
        "menu": [
          "Network",
          "Mobile",
          "Mobile"
        ],
        "hw_tags": {
          "mobile": true
        }
      }
    },
    "/modems/status/{id}": {
      "parameters": [
        {
          "schema": {
            "type": "string",
            "x-web": {
              "pretty": "Modem ID",
              "enum-depends": {
                "$ref": "#/x-schemas/modem_select"
              }
            }
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Modem ID"
        }
      ],
      "get": {
        "summary": "Returns full status for specified modem",
