  },
  "components": {
    "responses": {
      "200BgPe": {
        "description": "Returns section",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/bgp_peer_options_multi"
                }
              }
            }
          }
        }
      },
      "200BgPeMulti": {
        "description": "Returns sections",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/bgp_peer_options_multi"
                  }
                }
              }
            }
          }
        }
      },
      "bgp_available_interfaces": {
        "description": "Lists available interfaces for selection",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "object",
                  "description": "list of available interfaces",
                  "properties": {
                    "available_interfaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "parent": {
                            "type": "string",
                            "description": "Parent to which this interface belongs"
                          },
                          "ifname": {
                            "type": "string",
                            "description": "Interface name"
                          },
                          "service": {
                            "type": "string",
                            "description": "Service this interface belongs to"
                          },
                          "interfaces": {
                            "type": "string",
                            "description": "Logical interfaces to which the interface is assigned"
                          },
                          "ports": {
                            "type": "string",
                            "description": "Physical interfaces assigned to the bridge"
                          },
                          "child": {
                            "type": "string",
                            "description": "Child instance name"
                          }
                        },
                        "required": ["ifname"]
                      }
                    }
                  }
                }
              },
              "required": ["success", "data"]
            }
          }
        }
      }
    },
    "schemas": {
      "bgp_peer_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Enable/Disable BGP peer."
          },
          "as": {
            "x-web": {
              "pretty": "AS",
              "input-type": "input"
            },
            "type": "string",
            "description": "Neighbour's remote AS."
          },
          "ipaddr": {
            "x-web": {
              "pretty": "Remote address",
              "input-type": "input"
            },
            "type": "string",
            "description": "Neighbour's remote IPv4 address."
          },
          "port": {
            "x-web": {
              "pretty": "Remote port",
              "input-type": "input"
            },
            "type": "string",
            "description": "Neighbour's remote port."
          },
          "ebgp_multihop": {
            "x-web": {
              "pretty": "EBGP Multihop",
              "input-type": "input"
            },
            "type": "string",
            "description": "Time to Live value."
          },
          "weight": {
            "x-web": {
              "pretty": "Weight",
              "input-type": "input"
            },
            "type": "string",
            "description": "Specifies a default weight value for the neighbor's routes. Higher weight is preferred."
          },
          "timer_keepalive": {
            "x-web": {
              "pretty": "Keepalive timer",
              "input-type": "input"
            },
            "type": "string",
            "description": "Configures the intervals of keep alive messages."
          },
          "timer_holdtime": {
            "x-web": {
              "pretty": "Holdtime",
              "input-type": "input"
            },
            "type": "string",
            "description": "Configures how long to wait for a response from this neighbor before considering the peer unreachable."
          },
          "timer_connect": {
            "x-web": {
              "pretty": "Connect timer",
              "input-type": "input"
            },
            "type": "string",
            "description": "The amount of time in seconds, in which a connection to this peer must be established or else it is considered unsuccessful."
          },
          "default_originate": {
            "x-web": {
              "pretty": "Default originate",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Announce default routes to the peer."
          },
          "description": {
            "x-web": {
              "pretty": "Description",
              "input-type": "input"
            },
            "type": "string",
            "description": "You can leave notes here."
          },
          "password": {
            "x-web": {
              "pretty": "Password",
              "input-type": "input"
            },
            "type": "string",
            "description": "Password for this BGP Neighbor."
          },
          "instance": {
            "type": "string",
            "description": "Instance to which this entry belongs"
          },
          "allow_vpn": {
            "x-web": {
              "pretty": "Allow VPN",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Allow this BGP peer to exchange VPN routes."
          },
          "update_source": {
            "x-web": {
              "pretty": "Update source",
              "input-type": "input"
            },
            "type": "string",
            "description": "Interface to use as update source."
          }
        },
        "required": ["ipaddr"]
      },
      "bgp_peer_options_multi": {
        "title": "bgp_peer_options_multi",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "x-web": {
                  "pretty": "Configuration name",
                  "unique": true,
                  "input-type": "input"
                },
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/bgp_peer_options"
          }
        ]
      }
    }
  },
  "info": {
    "title": "BGP Peers",
    "version": "1.0",
    "description": "BGP peers api documentation"
  },
  "tags": [
    {
      "name": "Peers"
    }
  ]
}
