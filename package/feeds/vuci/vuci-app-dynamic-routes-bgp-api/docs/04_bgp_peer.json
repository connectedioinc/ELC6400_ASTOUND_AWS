    "/bgp/peer/config/{id}/options": {
      "get": {
        "summary": "Your GET endpoint",
        "tags": [],
        "responses": {
          "200": {
            "$ref": "#/components/responses/bgp_available_interfaces"
          }
        },
        "parameters": [
        {
          "schema": {
            "type": "string"
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "UCI BGP peer section identifier"
        }
      ]
      },
      "x-web": {
        "menu": ["Network", "Routing", "Dynamic Routes", "BGP"],
        "hw_tags": {
