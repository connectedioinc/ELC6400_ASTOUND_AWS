  "components": {
    "schemas": {
      "aws_provisioning": {
        "type": "object",
        "properties": {
          "template": {
            "description": "Name of Fleet provisioning template in AWS service.",
            "type": "string",
            "maxLength": 36,
            "format": "regex",
            "pattern": "^[A-Za-z0-9_-]+$",
            "x-web": {
              "pretty": "Template",
              "input-type": "input",
              "unique": true
            }
          },
          "type": {
            "description": "Fleet provisioning type.",
            "type": "string",
            "enum": ["1", "2"],
            "x-web": {
              "pretty": "Fleet provisioning type",
              "input-type": "select",
              "enum-pretty": {
                "1": "Provisioning by claim",
                "2": "Provisioning by trusted user"
              }
            }
          },
          "creation_type": {
            "description": "Specifies the AWS API to be used for certificate creation.",
            "type": "string",
            "enum": ["1", "2"],
            "x-web": {
              "pretty": "Creation type",
              "input-type": "select",
              "enum-pretty": {
                "1": "CreateKeysAndCertificate",
                "2": "CreateCertificateFromCsr"
              }
            }
          },
          "certfile": {
            "type": "string",
            "description": "Provisioning claim certificate.",
            "format": "file_validation",
            "x-web": {
              "upload_endpoint": "/aws/provisioning/config/{id}",
              "pretty": "Provisioning claim certificate",
              "input-type": "input",
              "depends": [
                {
                  "type": "1"
                }
              ],
              "require-depends": [
                {
                  "type": "1"
                }
              ]
            }
          },
          "keyfile": {
            "type": "string",
            "description": "Provisioning claim private key.",
            "format": "file_validation",
            "x-web": {
              "upload_endpoint": "/aws/provisioning/config/{id}",
              "pretty": "Provisioning claim private key",
              "input-type": "input",
              "depends": [
                {
                  "type": "1"
                }
              ],
              "require-depends": [
                {
                  "type": "1"
                }
              ]
            }
          },
          "access_key": {
            "type": "string",
            "description": "Trusted user's access key.",
            "maxLength": 20,
            "minLength": 20,
            "format": "regex",
            "pattern": "^[A-Z0-9]+$",
            "x-web": {
              "pretty": "Access key",
              "input-type": "input",
              "depends": [
                {
                  "type": "2"
                }
              ],
              "require-depends": [
                {
                  "type": "2"
                }
              ]
            }
          },
          "secret_key": {
            "type": "string",
            "description": "Trusted user's secret key.",
            "maxLength": 40,
            "minLength": 40,
            "format": "default_validation",
            "x-web": {
              "pretty": "Secret key",
              "input-type": "input",
              "depends": [
                {
                  "type": "2"
                }
              ],
              "require-depends": [
                {
                  "type": "2"
                }
              ]
            }
          },
          "param": {
            "type": "array",
            "description": "Parameters which will be sent along with the certificate creation request. Value must be in the format \"key:value\". It will be formatted as JSON values (\"key\": \"value\"). Additional device parameters can be used: %device% - Device name, \n %mac% - MAC address, \n %maceth% - WAN MAC address, \n %batch% - Batch, \n %hwver% - Hardware version, \n %serial% - Serial number, \n %time% - Time now, \n %thing% - AWS Thing name.",
            "format": "regex",
            "pattern": "^[a-zA-Z0-9:%%_-]+$",
            "x-web": {
              "pretty": "Parameters",
              "input-type": "input"
            },
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["template", "type", "creation_type"]
      },
      "req_body_aws_provisioning_one": {
        "description": "",
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/aws_provisioning"
          }
        },
