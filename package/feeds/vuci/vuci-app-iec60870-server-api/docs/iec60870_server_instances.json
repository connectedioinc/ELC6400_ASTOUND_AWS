                },
                {
                  "depends": {
                    "device": "/dev/mbus"
                  },
                  "values": [
                    "even",
                    "odd",
                    "none"
                  ]
                }
              ]
            }
          },
          "flowcontrol": {
            "type": "string",
            "enum": [
              "none",
              "xon/xoff",
              "rts/cts"
