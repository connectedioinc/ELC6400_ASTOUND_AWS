    "schemas": {
      "iec60870_server_instance_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "format": "is_bool",
            "type": "string",
            "description": "Check to enable this configuration.",
            "x-web": {
              "pretty": "Enabled",
              "input-type": "switch",
              "group": "General"
            }
          },
          "name": {
            "type": "string",
            "description": "Name of the server. Used for easier device management purposes only.",
            "x-web": {
              "pretty": "Name",
              "input-type": "input",
              "group": "General"
            }
          },
          "common_address": {
            "type": "string",
            "format": "irange(1,65534)",
            "description": "Common address of the ASDU. Is sometimes also referred to as the application layer address.",
            "x-web": {
              "pretty": "Common address",
              "input-type": "input",
              "group": "General",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "spontaneous_enabled": {
            "format": "is_bool",
            "type": "string",
            "description": "Enable the transmission of spontaneous events. Will notify clients when an object changes.",
            "x-web": {
              "pretty": "Enable spontaneous transmission",
              "input-type": "switch",
              "group": "General",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "spontaneous_information_objects": {
            "type": "array",
            "description": "List of information object for which spontaneous messages will be sent.",
            "items": {
              "type": "string"
            },
            "x-web": {
              "pretty": "Spontaneous information objects",
              "group": "General"
            }
          },
          "cyclic_enabled": {
            "format": "is_bool",
            "type": "string",
            "description": "Enable the transmission of cyclic messages. Will send the current values of changes on configured period.",
            "x-web": {
              "pretty": "Enable cyclic transmission",
              "input-type": "switch",
              "group": "General",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "cyclic_period": {
            "type": "string",
            "format": "irange(1000,86400000)",
            "description": "Duration in milliseconds for how often cyclic messages should be sent.",
            "x-web": {
              "pretty": "Cyclic transmission period",
              "input-type": "input",
              "group": "General",
              "require-depends": [
                {
                  "cyclic_enabled": "1"
                }
              ]
            }
          },
          "cyclic_information_objects": {
            "type": "array",
            "description": "List of information object for which cyclic messages will be sent.",
            "items": {
              "type": "string"
            },
            "x-web": {
              "pretty": "Cyclic information objects",
              "group": "General"
            }
          },
          "configure_pins": {
            "format": "is_bool",
            "type": "string",
            "description": "Manually specify which I/O will be available as information objects.",
            "x-web": {
              "pretty": "Configure I/O pins",
              "input-type": "switch",
              "group": "General"
            }
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-web": {
              "pretty": "I/O pins",
              "group": "General"
            }
          },
          "connection_type": {
            "type": "string",
            "enum": [
              "iec104"
            ],
            "description": "Server connection type",
            "x-web": {
              "pretty": "Connection type",
              "input-type": "select",
              "enum-pretty": {
                "iec104": "IEC 104 (TCP)",
                "iec101": "IEC 101 (Serial)"
              },
              "group": "Connection",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ],
              "enum-depends": [
                {
                  "hw_tags": {
                    "serial": true
                  },
                  "values": [
                    "iec104",
                    "iec101"
                  ]
                }
              ]
            }
          },
          "port": {
            "type": "string",
            "format": "port",
            "description": "Specify port number for server to listen.",
            "x-web": {
              "pretty": "Port",
              "input-type": "input",
              "group": "Connection",
              "require-depends": [
                {
                  "connection_type": "iec104"
                }
              ]
            }
          },
          "allow_remote_access": {
            "format": "is_bool",
            "type": "string",
            "description": "Allow access through WAN.",
            "x-web": {
              "pretty": "Allow remote access",
              "input-type": "switch",
              "group": "Connection"
            }
          },
          "balanced": {
            "type": "string",
            "format": "is_bool",
            "description": "Whether communication is balanced (both can initiate) or unbalanced (only one initiates).",
