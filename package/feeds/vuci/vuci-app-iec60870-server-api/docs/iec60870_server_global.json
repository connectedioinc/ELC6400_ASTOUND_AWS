    "schemas": {
      "iec60870_server_global_options": {
        "type": "object",
        "required": ["enabled"],
        "properties": {
          "enabled": {
            "type": "string",
            "description": "Enable/disable IEC 60870-5 server service.",
            "format": "is_bool",
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            },
            "enum": [
              "0",
              "1"
            ]
          }
        }
      },
      "iec60870_server_status": {
        "type": "object",
        "required": ["uptime"],
        "properties": {
          "uptime": {
            "format": "uinteger",
            "type": "string"
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "connection_type": {
                  "type": "string",
                  "enum": [
                    "iec104"
                  ],
                  "x-web": {
                    "pretty": "Connection type",
                    "enum-depends": [
                      {
                        "hw_tags": {
                          "serial": true
                        },
                        "values": [
                          "iec104",
                          "iec101"
                        ]
                      }
                    ]
                  }
                },
                "link_layer_state": {
                  "type": "string",
                  "enum": [
                    "0",
                    "1",
                    "2",
                    "3"
                  ]
                },
                "connected_clients": {
                  "type": "string",
                  "format": "uinteger"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
