                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "openconnect_client_options": {
        "type": "object",
        "description": "OpenConnect configuration section",
        "title": "",
        "properties": {
          "enabled": {
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch",
              "group": "Main settings"
            },
            "type": "string",
            "description": "Turns the OpenConnect instance on or off.",
            "enum": ["0", "1"]
          },
          "server": {
            "x-web": {
              "pretty": "Server address",
              "input-type": "input",
              "group": "Main settings"
            },
            "type": "string",
            "description": "Server IP address"
          },
          "vpn_protocol": {
            "type": "string",
            "description": "Servers VPN protocol, available choices: anyconnect, nc, gp, pulse, f5, fortinet, array",
            "x-web": {
              "pretty": "VPN protocol",
              "input-type": "input",
              "group": "Main settings"
            }
          },
          "serverhash": {
            "x-web": {
              "pretty": "Fingerprint",
              "input-type": "switch",
              "group": "Main settings"
            },
            "type": "string",
            "description": "Specify servers public key fingerprint to trust"
          },
          "port": {
            "type": "string",
            "x-web": {
              "pretty": "Port",
              "input-type": "input",
              "group": "Main settings"
            },
            "description": "TCP port on which server is listening for connections"
          },
          "username": {
            "x-web": {
              "pretty": "Username",
              "input-type": "input",
              "group": "Main settings"
            },
            "type": "string",
            "description": "Username used for authentication to the server"
          },
          "password": {
            "x-web": {
              "pretty": "Password",
              "input-type": "input",
              "group": "Main settings"
            },
            "type": "string",
            "description": "Password used for authentication to the server"
          },
          "ca_cert": {
            "x-web": {
              "upload_endpoint": "/openconnect/client/config/{id}",
              "pretty": "CA certificate",
              "input-type": "input",
              "group": "Main settings"
            },
            "type": "string",
            "description": "CA certificate used to verify the server certificate"
          },
          "user_cert": {
            "x-web": {
              "upload_endpoint": "/openconnect/client/config/{id}",
              "pretty": "User certificate",
              "input-type": "input",
              "group": "Main settings"
            },
            "type": "string",
            "description": "User certificate used to authenticate to the server"
          },
          "use_tpm": {
            "type": "string",
            "x-web": {
              "pretty": "Store keys in TPM",
              "input-type": "switch",
              "hw_tags": {
                "has_tpm": true
              }
            },
            "format": "is_bool",
            "description": "If enabled, the private key will be stored in TPM2 secure storage, if space is available",
            "default": 1
          },
          "user_key": {
            "x-web": {
              "upload_endpoint": "/openconnect/client/config/{id}",
              "pretty": "User private key",
              "input-type": "input",
              "group": "Main settings"
            },
            "type": "string",
            "description": "User private key used to authenticate to the server"
          }
        }
      },
      "openconnect_client_options_id": {
        "description": "OpenConnect configuration section",
        "title": "",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "x-web": {
                  "pretty": "Configuration name",
                  "unique": true,
                  "input-type": "input"
                },
                "type": "string",
                "description": "Section name"
              }
            }
          },
          {
            "$ref": "#/components/schemas/openconnect_client_options"
          }
        ],
        "x-examples": {
          "example-1": {
            "id": "string",
            "enabled": "0",
            "ipaddr_tunlink": "string",
            "peeraddr": "string",
            "mtu": "string",
            "okey": "string",
            "ikey": "string",
            "df": "string",
            "ttl": "string",
            "keep_alive": "string",
            "keep_alive_interval": "string",
            "keep_alive_retries": "string",
            "tun_ipaddr": "string",
            "tun_netmask": "string",
            "service": "string"
          }
        }
      },
      "openconnect_status": {
        "title": "openconnect_status",
        "type": "object",
        "properties": {
          "ipv4-address": {
            "type": "string",
            "description": "Tunnel IPv4 address"
          },
          "ipv6-address": {
            "type": "string",
            "description": "Tunnel IPv6 address"
          },
          "active": {
            "type": "boolean",
            "description": "Is the OpenConnect instance active"
          }
        }
      }
    }
  },
