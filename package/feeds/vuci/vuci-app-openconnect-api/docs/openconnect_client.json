    "/openconnect/client/actions/check_fingerprint": {
      "post": {
        "summary": "",
        "operationId": "post-openconnect-actions-check_fingerprint",
        "responses": {
          "201": {
            "$ref": "#/components/responses/openconnect_action"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "description": "Checks servers SSL certificate and generates a fingerprint from it's public key",
        "tags": ["General"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "server": {
                    "type": "string",
                    "format": "uri"
                  },
                  "port": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "description": "Server address and port to check for fingerprint"
        }
      },
