      "post": {
        "summary": "Uploads OpenConnect client certificates",
        "responses": {
          "200": {
            "$ref": "#/components/responses/file_response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "tags": ["General"],
        "operationId": "post-openconnect-cfg-upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "option": {
                    "type": "string",
                    "description": "Parameter to upload the file to.",
                    "enum": ["user_key", "user_cert", "ca_cert"]
                  },
                  "file": {
                    "type": "string",
                    "description": "File to upload.",
                    "format": "binary"
                  }
                },
                "required": ["option", "file"]
              }
            }
          }
        }
      },
      "parameters": [
        {
          "schema": {
            "type": "string"
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Uci configuration OpenConnect section identifier"
        }
      ],
      "x-web": {
