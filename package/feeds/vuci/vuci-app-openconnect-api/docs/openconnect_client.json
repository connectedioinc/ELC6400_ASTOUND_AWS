        "responses": {
          "200": {
            "$ref": "#/components/responses/openconnect_client_one"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "operationId": "put-openconnect-cfg",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
