    "/openconnect/client/status": {
      "get": {
        "summary": "Returns status of OpenConnect instances",
        "tags": ["General"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "instance name": {
                          "$ref": "#/components/schemas/openconnect_status"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "example-1": {
                    "value": {
                      "success": true,
                      "data": {
                        "test3": {
                          "ipv6-address": "fda9:4efe:7e3b:84ed:7960:92fa:f28e:8849/128"
                        },
                        "test2": {
                          "ipv4-address": "192.168.100.1"
                        },
                        "test1": {
                          "ipv4-address": "192.168.100.1",
                          "ipv6-address": "fda9:4efe:7e3b:84ed:7960:92fa:f28e:8849/128"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "operationId": "get-openconnect-client-status"
      },
      "x-web": {
        "menu": ["Services", "VPN", "OpenConnect"],
        "hw_tags": {
          "is_switch": false,
          "is_access_point": false,
          "flash16mb": false
        },
        "name": "OpenConnect"
      }
    },
    "/openconnect/client/status/{id}": {
      "get": {
        "summary": "Returns status of OpenConnect instance",
        "tags": ["General"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/openconnect_status"
                    }
                  }
                },
                "examples": {
                  "example-1": {
                    "value": {
                      "success": true,
                      "data": {
                        "test1": {
                          "ipv4-address": "192.168.100.1"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-openconnect-client-status-id"
      },
      "parameters": [
        {
          "schema": {
            "type": "string"
          },
          "name": "id",
          "in": "path",
          "required": true
        }
      ],
      "x-web": {
        "menu": ["Services", "VPN", "OpenConnect"],
        "hw_tags": {
          "is_switch": false,
          "is_access_point": false,
          "flash16mb": false
        },
