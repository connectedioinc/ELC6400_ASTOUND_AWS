    "schemas": {
      "azure_iothub_pnp_single_section": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "enabled": {
                "description": "Enable Azure IoT Hub monitoring",
                "type": "string",
                "enum": ["0", "1"],
                "format": "is_bool",
                "x-web": {
                  "pretty": "Enable Azure IoT Hub monitoring",
                  "input-type": "switch"
                }
              }
            }
          },
          {
            "$ref": "#/components/schemas/azure_iothub_merge_action_options"
          }
        ]
      },
      "azure_iothub_merge_action_options": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Azure IoT Hub section name.",
            "format": "uciname",
            "maxLength": 256,
            "x-web": {
              "pretty": "Name",
              "input-type": "input",
              "unique": true
            }
          },
          "direct_methods_enabled": {
            "description": "Enable Direct Method feature set.",
            "type": "string",
            "enum": ["0", "1"],
            "format": "is_bool",
            "x-web": {
              "pretty": "Enable Direct Methods",
              "input-type": "switch"
            }
          },
          "model_id": {
            "type": "string",
            "description": "Model ID of the Digital Twins Definition Language.",
            "maxLength": 256,
            "x-web": {
              "pretty": "Plug and Play device model ID",
              "input-type": "input",
              "depends": [
                {
                  "direct_methods_enabled": "1"
                }
              ]
            }
          },
          "connection_type": {
            "type": "string",
            "description": "Connection type to an existing IoT Hub.",
            "enum": ["iothub", "provisioning"],
            "x-web": {
              "pretty": "Attestation method",
              "input-type": "select",
              "enum-pretty": {
                "iothub": "Shared Access Signature (SAS) key",
                "provisioning": "Device Provisioning Service (DPS)"
              }
            }
          },
          "connection_string": {
            "type": "string",
            "maxLength": 4096,
            "description": "Connection string based on primary key used in API calls which allows device to communicate with IoT Hub.",
            "x-web": {
              "pretty": "Connection String",
              "input-type": "input",
              "depends": [
                {
                  "connection_type": "iothub"
                }
              ]
            }
          },
          "attestation_mechanism": {
            "type": "string",
            "description": "Method used to confirm a device's identity in Device Provisioning Service.",
            "enum": ["x509_certificate", "symmetric_key"],
            "x-web": {
              "pretty": "DPS attestation method",
              "input-type": "select",
              "enum-pretty": {
                "x509_certificate": "X.509 certificates",
                "symmetric_key": "Symmetric Key"
              },
              "depends": [
                {
                  "connection_type": "provisioning"
                }
              ]
            }
          },
          "id_scope": {
            "type": "string",
            "description": "Unique identifier that is assigned to an Azure IoT Hub during its creation and is used to uniquely identify the specific provisioning service the device will register through.",
            "maxLength": 100,
            "x-web": {
              "pretty": "ID Scope",
              "input-type": "input",
              "depends": [
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "x509_certificate"
                },
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "symmetric_key"
                }
              ]
            }
          },
          "registration_id": {
            "type": "string",
            "description": "The registration ID is used to uniquely identify a device registration with the Device Provisioning Service.",
            "maxLength": 128,
            "x-web": {
              "pretty": "Registration ID",
              "input-type": "input",
              "depends": [
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "x509_certificate"
                },
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "symmetric_key"
                }
              ]
            }
          },
          "symmetric_key": {
            "type": "string",
            "description": "The derived device key from the DPS Primary Key.",
            "maxLength": 128,
            "x-web": {
              "pretty": "Symmetric Key",
              "input-type": "input",
              "depends": [
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "symmetric_key"
                }
              ]
            }
          },
          "x509certificate": {
            "type": "string",
            "description": "Upload the 'leaf' certificate file.",
            "format": "file_validation",
            "x-web": {
              "upload_endpoint": "/azure/iot_hub/config/{id}",
              "pretty": "X.509 Certificate",
              "input-type": "input",
              "depends": [
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "x509_certificate"
                }
              ]
            }
          },
          "x509certificate:file_size": {
            "description": "Uploaded 'x509certificate' file size in bytes.",
            "type": "number",
            "readOnly": true
          },
          "x509privatekey": {
            "type": "string",
            "description": "Upload the 'leaf' key file.",
            "format": "file_validation",
            "x-web": {
              "upload_endpoint": "/azure/iot_hub/config/{id}",
              "pretty": "X.509 Private Key",
              "input-type": "input",
              "depends": [
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "x509_certificate"
                }
              ]
            }
          },
          "x509privatekey:file_size": {
            "description": "Uploaded 'x509privatekey' file size in bytes.",
            "type": "number",
            "readOnly": true
          },
          "global_prov_uri": {
            "type": "string",
            "description": "Destination for messages sent by IoT devices to the Azure IoT Hub (will default to global.azure-devices-provisioning.net if not set).",
            "x-web": {
              "pretty": "Global Device Endpoint",
              "input-type": "input",
              "depends": [
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "x509_certificate"
                },
                {
                  "connection_type": "provisioning",
                  "attestation_mechanism": "symmetric_key"
                }
              ]
            }
          }
        },
        "required": ["name"]
      },
      "azure_iothub_pnp_single_section_with_id": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Azure Iot Hub Configuration identifier (ID)."
              }
            }
          },
          {
            "$ref": "#/components/schemas/azure_iothub_pnp_single_section"
          }
        ],
        "required": ["id"]
      },
      "azure_iothub_pnp_status": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Azure Iot Hub Configuration identifier (ID)."
          },
          "name": {
            "type": "string",
            "description": "Azure IoT Hub section name."
          },
          "connection_status": {
            "type": "string",
            "enum": ["n/a", "disabled", "authenticated", "unauthenticated"]
          },
          "connection_status_reason": {
            "enum": ["n/a", "ok", "expired sas token", "device disabled", "bad credentials", "retry expired", "no network", "communication error", "no ping response", "quota exceeded"],
            "type": "string"
          }
        }
      },
      "azure_merge_success_message": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "Message code"
          },
          "source": {
            "type": "string",
            "description": "Message source"
          },
          "message": {
            "type": "string",
            "description": "Message text"
          }
        },
        "required": ["code", "message", "source"]
      }
    }
  }
