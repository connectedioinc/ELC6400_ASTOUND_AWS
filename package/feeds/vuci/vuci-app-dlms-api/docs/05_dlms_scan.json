        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/200response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/scan_action_body"
                  }
                }
              }
            }
          }
        }
      },
      "x-web": {
        "name": "DLMS",
        "menu": [
          "Services",
