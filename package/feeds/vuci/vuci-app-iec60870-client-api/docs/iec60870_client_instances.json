              "pretty": "Timeout",
              "input-type": "input",
              "group": "General",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "connection_type": {
            "type": "string",
            "enum": [
              "iec104"
            ],
            "description": "Client connection type",
            "x-web": {
              "pretty": "Connection type",
              "input-type": "select",
              "enum-pretty": {
                "iec104": "IEC 104 (TCP)"
              },
              "group": "Connection",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "ip": {
            "type": "string",
            "format": "ip4addr",
