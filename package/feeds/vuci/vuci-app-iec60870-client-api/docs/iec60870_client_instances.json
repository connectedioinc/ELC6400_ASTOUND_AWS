              "group": "General",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          },
          "timeout": {
            "type": "string",
            "format": "irange(1,60)",
            "description": "Time in seconds that the client waits for a response to an interrogation request.",
