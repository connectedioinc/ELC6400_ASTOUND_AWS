            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "description": "Operation status",
                  "type": "boolean"
                },
                "data": {
                  "type": "array",
                  "description": "",
                  "items": {
                    "$ref": "#/components/schemas/cumulocity_options"
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "cumulocity_single_options": {
        "allOf": [
          {
            "type": "object",
            "title": "",
            "description": "Options required to configure a working cumulocity service.",
            "properties": {
              "enabled": {
                "type": "string",
                "description": "Enable cumulocity application.",
                "format": "is_bool",
                "enum": ["0", "1"],
                "x-web": {
                  "pretty": "Enable",
                  "input-type": "switch"
                }
              },
              "ssl": {
                "type": "string",
                "description": "Use SSL/TLS protocol.",
                "enum": ["0", "1"],
                "format": "is_bool",
                "x-web": {
                  "pretty": "Use SSL/TLS",
                  "input-type": "switch"
                }
              },
              "server": {
                "type": "string",
                "description": "Cumulocity server address.",
                "format": "host",
                "x-web": {
                  "pretty": "Server Address",
                  "input-type": "input",
                  "require-depends": [
                    {
                      "enabled": "1"
                    }
                  ]
                }
              },
              "port": {
                "type": "string",
                "description": "Cumulocity server port.",
                "format": "port",
                "default": "8883",
                "x-web": {
                  "pretty": "Port",
                  "input-type": "input"
                }
              }
            }
          },
          { "$ref": "#/components/schemas/cloud_of_things_options_single_options_base" }
        ]
      },
      "cumulocity_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Cumulocity Configuration identifier (ID)."
              }
            },
            "required": ["id"]
          },
          {
            "$ref": "#/components/schemas/cumulocity_single_options"
          }
        ]
      }
    }
