    "/cloud_of_things/config/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Configuration ID"
        }
      ],
      "get": {
        "summary": "Returns Cloud of Things configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200CoT"
          }
        },
        "tags": [
          "General"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "summary": "Updates Cloud of Things configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200CoT"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
