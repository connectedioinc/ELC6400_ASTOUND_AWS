  "components": {
    "responses": {
      "200CoT": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "description": "Operation status",
                  "type": "boolean"
                },
                "data": {
                  "$ref": "#/components/schemas/cloud_of_things_options"
                }
              }
            }
          }
        }
      },
      "200CoTMulti": {
        "description": "Returns configurations",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/cloud_of_things_options"
                  }
                }
              }
            }
          }
        }
      },
      "200CoTStatus": {
        "description": "Returns status",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "description": "Connection state",
                      "enum": ["Not connected", "Connecting", "Registering", "Connected"]
                    },
                    "state_id": {
                      "type": "integer",
                      "description": "Connection state id",
                      "enum": [0, 1, 2, 3]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "cloud_of_things_options_single_options_base": {
        "type": "object",
        "properties": {
          "qos": {
            "type": "string",
            "description": "Quality of Service.",
            "enum": ["0", "1", "2"],
            "default": "1",
            "x-web": {
              "pretty": "QoS",
              "enum-pretty": {
                "0": "At most once (0)",
                "1": "At least once (1)",
                "2": "Exactly once (2)"
              },
              "input-type": "select"
            }
          },
          "keepalive": {
            "type": "string",
            "description": "Keepalive time in seconds.",
            "format": "irange(0,2147483647)",
            "default": "60",
            "x-web": {
              "pretty": "Keepalive",
              "input-type": "input"
            }
          },
          "interval": {
            "type": "string",
            "description": "Push connection interval in minutes.",
            "format": "irange(1,32767)",
            "x-web": {
              "pretty": "Interval",
              "input-type": "input",
              "require-depends": [
                {
                  "enabled": "1"
                }
              ]
            }
          }
        }
      },
      "cloud_of_things_options_single_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "string",
                "description": "Enable Cloud of Things application.",
                "format": "is_bool",
                "enum": ["0", "1"],
                "x-web": {
                  "pretty": "Enable",
                  "input-type": "switch"
                }
              },
              "server": {
                "type": "string",
                "description": "Cloud of Things server address.",
                "format": "host",
                "x-web": {
                  "pretty": "Server address",
                  "input-type": "input",
                  "require-depends": [
                    {
                      "enabled": "1"
                    }
                  ]
                }
              },
              "port": {
                "type": "string",
                "description": "Cloud of Things server port.",
                "format": "port",
                "default": "8883",
                "x-web": {
                  "pretty": "Port",
                  "input-type": "input"
                }
              }
            }
          },
          { "$ref": "#/components/schemas/cloud_of_things_options_single_options_base" }
        ]
      },
      "cloud_of_things_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Cloud of Things Configuration identifier (ID)."
              }
            },
            "required": ["id"]
          },
          {
            "$ref": "#/components/schemas/cloud_of_things_options_single_options"
          }
        ]
      }
    }
  }
}