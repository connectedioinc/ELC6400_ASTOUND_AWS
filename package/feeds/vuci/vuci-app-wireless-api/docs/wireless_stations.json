          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/wifi_station"
                  }
                }
              }
            }
          }
        },
        "tags": ["Station"]
      },
      "delete": {
        "summary": "Deletes wireless station configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200deleted"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
