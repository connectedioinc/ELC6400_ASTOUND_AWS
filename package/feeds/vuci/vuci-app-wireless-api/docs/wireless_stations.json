        "tags": ["Station"]
      },
      "x-web": {
        "menu": ["Network", "Wireless", "PPSK"],
        "hw_tags": {
          "wifi": true
        },
        "hidden_documentation_page": true
      }
    }
  },
  "components": {
    "schemas": {
      "wifi_station": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "User name of the authenticating station. Used for easier identification.",
            "x-web": {
              "pretty": "Username",
              "input-type": "input"
            }
          },
          "mac": {
            "type": "string",
            "description": "MAC address to match authenticating stations against (defaults to any station using this key).",
            "format": "macaddr",
            "x-web": {
              "pretty": "MAC address",
              "input-type": "input"
            }
          },
          "key": {
            "type": "string",
            "description": "PSK to match authenticating stations against.",
            "x-web": {
              "pretty": "Key",
              "input-type": "input"
            }
          },
          "vid": {
            "type": "string",
            "description": "VLAN ID to assign station to (defaults to no VLAN).",
            "format": "irange(1,4094)",
            "x-web": {
              "pretty": "VLAN ID",
              "input-type": "input",
              "hw_tags": {
                "is_access_point": true
              }
            }
          },
          "network": {
            "type": "string",
            "description": "Network that this station will be assigned to.",
            "x-web": {
              "pretty": "Network",
              "input-type": "input",
              "hw_tags": {
                "is_access_point": false
              }
            }
          },
          "psk_group": {
            "type": "string",
            "description": "PSK group associated with the station. Must reference an existing group.",
            "x-web": {
              "pretty": "PSK group",
              "input-type": "input"
            }
          }
        },
        "required": ["id", "key"]
      },
      "wifi_station_id": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "ID of the WiFi station"
              }
            }
          },
          {
            "$ref": "#/components/schemas/wifi_station"
          }
        ]
      }
    }
  }
}
