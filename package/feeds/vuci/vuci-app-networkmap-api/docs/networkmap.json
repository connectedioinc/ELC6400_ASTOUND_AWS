    "requestBodies": {
      "devices_scan": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "scan_type": {
                      "type": "string",
                      "description": "Scan type can be 'lan', 'wan' or 'all'",
                      "x-web": {
                        "pretty": "Scan type",
                        "input-type": "input"
                      }
                    }
                  },
                  "required": ["scan_type"]
                }
              }
            }
          }
        }
      },
      "start_scan": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "device": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      },
                      "description": "Device name with IPv4 address and netmask is accepted. E.g. br-lan:192.168.1.0/24",
                      "x-web": {
                        "pretty": "Device",
                        "input-type": "input"
                      }
                    }
                  },
                  "required": ["device"]
                }
              }
            }
          }
        }
      }
