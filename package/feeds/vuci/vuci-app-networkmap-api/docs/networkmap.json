  "paths": {
    "/topology/status": {
      "get": {
        "summary": "Get interfaces information for devices scanning",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200_networkmap_interfaces"
          }
        },
        "operationId": "get-status-networkmap-interfaces",
        "description": "Interfaces information for devices scanning",
        "tags": ["General"]
      },
      "parameters": [],
      "x-web": {
        "menu": ["Status", "Network", "Topology"],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/topology/scan/status": {
      "get": {
        "summary": "Get history of started scans",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200_networkmap_results"
          }
        },
        "description": "Scan history",
        "tags": ["General"]
      },
      "parameters": [],
      "x-web": {
        "menu": ["Status", "Network", "Topology"],
        "hw_tags": {
          "is_access_point": false
        }
      }
    },
    "/topology/actions/start_scan": {
      "post": {
        "summary": "Start topology scan",
