            }
          }
        }
      },
      "cert_details": {
        "description": "Returns certificate details.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "valid_to": {
                      "type": "string",
