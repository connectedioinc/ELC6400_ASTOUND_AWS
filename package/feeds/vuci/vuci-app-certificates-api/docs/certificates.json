  "paths": {
    "/certificates/config": {
      "get": {
        "summary": "Returns all generated and uploaded certificates, keys, DH parameters and CAs",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200CertGet"
          }
        },
        "parameters": [
          {
            "name": "include_tpm2",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Includes keys that are in tpm2 storage"
          }
        ],
        "tags": ["General"]
      },
      "post": {
        "summary": "Uploads certificate",
        "responses": {
          "200": {
            "description": "Returns success when certificate is successfully uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "$ref": "#/components/requestBodies/file_upload_certificates"
        },
        "tags": ["General"]
      },
      "x-web": {
        "menu": ["System", "Administration", "Certificates"],
        "hw_tags": {
          "is_access_point": false,
          "is_switch": false
        }
      }
    },
