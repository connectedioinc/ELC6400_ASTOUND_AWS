                    },
                    "subject_key_identifier": {
                      "type": "string",
                      "description": "Subject Key Identifier"
                    },
                    "key_usage": {
                      "type": "string",
                      "description": "Key usage purposes"
                    },
                    "common_name": {
                      "type": "string",
                      "description": "Common name"
                    },
                    "state": {
                      "type": "string",
                      "description": "State or province"
                    },
                    "authority_key_identifier": {
                      "type": "string",
                      "description": "Authority Key Identifier"
                    },
                    "locality": {
                      "type": "string",
                      "description": "Locality or city"
                    },
                    "basic_constraints": {
                      "type": "string",
                      "description": "Basic constraints"
                    },
                    "valid_from": {
                      "type": "string",
                      "description": "Certificate validity start date"
                    },
                    "organization": {
                      "type": "string",
                      "description": "Organization name"
                    },
                    "email": {
                      "type": "string",
                      "description": "Email address"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "cert_options": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["key", "cert", "dh"],
            "description": "File type."
          },
          "name": {
            "type": "string",
            "description": "Name of generated certificate."
          },
          "host": {
            "type": "string",
            "description": "Certificate's alt hostname"
          },
          "cert_type": {
            "type": "string",
            "description": "Certificate type.",
            "enum": ["client", "server", "ca", "root_ca", "import", "letsencrypt", "scep", "public_key"]
          },
          "key_size": {
            "type": "string",
            "description": "Key size used to generate the certificate."
          },
          "fullname": {
            "type": "string",
            "description": "File name."
          },
          "datetime": {
            "type": "string",
            "description": "Time of generation."
          },
          "import": {
            "type": "boolean",
            "description": "Certificate is imported."
          },
          "auto_renew": {
            "type": "boolean",
            "description": "Certificate will be automatically renewed."
          },
          "dns": {
            "type": "array",
            "description": "Certificates alt name DNS field.",
            "items": {
              "type": "string"
            }
          },
          "ip": {
            "type": "array",
            "description": "Certificates alt name IP addresses field.",
            "items": {
              "type": "string"
            }
          },
          "encryption": {
            "type": "string",
            "description": "Encryption type of certificate"
          },
          "pass_required": {
            "type": "boolean",
            "description": "Encrypted certificate will require pass phrase."
          },
          "scep_url": {
            "type": "string",
            "description": "SCEP URL"
          },
          "signed_by": {
            "type": "string",
            "description": "File name of key that certificate was signed by."
          },
          "path": {
            "type": "string",
            "description": "Path to certificate file"
          },
          "tpm2": {
            "type": "boolean",
            "description": "Certificate is uploaded to tpm2 storage"
          },
          "services": {
            "type": "array",
            "description": "Services that use this certificate.",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+$",
              "description": "Service and instance in format 'service:instance'"
            }
          }
        }
      },
      "generation_options": {
        "type": "object",
        "properties": {
          "type": {
            "x-web": {
              "pretty": "File Type",
              "input-type": "select",
              "enum-pretty": {
                "ca": "CA",
                "client": "Client",
                "server": "Server",
                "simple": "Simple",
                "dh": "DH Parameters",
                "letsencrypt": "Let's Encrypt",
                "scep": "SCEP"
              }
            },
            "type": "string",
            "description": "Type of file to be generated. Select option \"Simple\" to generate ca, server & client certificates & keys. Select option \"Let's encrypt\" to generate SSL certificates. Select SCEP to generate certificates via SCEP server.",
            "enum": ["ca", "client", "server", "simple", "dh", "letsencrypt", "scep"]
          },
          "host": {
            "x-web": {
              "pretty": "Host address",
              "input-type": "input"
            },
            "type": "string",
            "description": "Certificate's alt hostname"
          },
          "days": {
            "x-web": {
              "pretty": "Days",
              "input-type": "input",
              "depends": [
                {
                  "sign": "1"
                }
              ]
            },
            "type": "string",
            "description": "Days until certificate expires.",
            "format": "uinteger"
          },
          "key_size": {
            "x-web": {
              "pretty": "Key Size",
              "input-type": "select"
            },
            "type": "string",
            "description": "Certificate key size.",
            "enum": ["512", "1024", "2048", "4096"]
          },
          "subject": {
            "x-web": {
              "pretty": "Subject information",
              "input-type": "input"
            },
            "type": "string",
            "description": "Subject information for certificate. format: /C=US/ST=CA/L=San Francisco/O=My Company/OU=My Unit/CN=My Common Name"
          },
          "ca": {
            "x-web": {
              "pretty": "CA File Name",
              "input-type": "select",
              "depends": [
                {
                  "sign": "1"
                }
              ]
            },
            "type": "string",
            "description": "Certificate authority file (Used for signing client and server certificates."
          },
          "ca_key": {
            "x-web": {
              "pretty": "CA Key",
              "input-type": "select",
              "depends": [
                {
                  "sign": "1"
                }
              ]
            },
            "type": "string",
            "description": "Certificate authority key for matching certificate authority file."
          },
          "name": {
            "x-web": {
              "pretty": "Name (CN)",
              "input-type": "input"
            },
            "type": "string",
            "description": "Common name and file name of the certificate."
          },
          "sign": {
            "x-web": {
              "pretty": "Sign The Certificate",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Check this to sign the generated certificate with CA file.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "delete": {
            "x-web": {
              "pretty": "Delete Signing Request",
              "input-type": "switch",
              "depends": [
                {
                  "sign": "1"
                }
              ]
            },
            "type": "string",
            "description": "Delete certificate signing request after signing.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "renew": {
            "x-web": {
              "pretty": "Renew Certificate",
              "input-type": "switch",
              "depends": [
                {
                  "type": "letsencrypt"
                }
              ]
            },
            "type": "string",
            "description": "Automatically renew certificate before it expires.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "pass": {
            "x-web": {
              "pretty": "Password",
              "input-type": "input",
              "depends": [
                {
                  "sign": "1"
                }
              ]
            },
            "type": "string",
            "description": "Private Key Decryption Password.",
            "format": "credentials_validate"
          },
          "scep_server": {
            "x-web": {
              "pretty": "SCEP server URL",
              "input-type": "input",
              "depends": [
                {
                  "type": "scep"
                }
              ]
            },
            "type": "string",
            "description": "URL of SCEP server",
            "format": "url"
          },
          "password": {
            "x-web": {
              "pretty": "Password",
              "input-type": "input",
              "group": "General Settings",
              "depends": [
                {
                  "type": "scep"
                }
              ]
            },
            "type": "string",
            "format": "credentials_validate",
            "description": "Password / challenge for connecting to SCEP server"
          }
        }
      },
      "sign_options": {
        "type": "object",
        "properties": {
          "name": {
            "x-web": {
              "pretty": "Signed Certificate Name",
              "input-type": "input"
            },
            "type": "string",
            "description": "Common name and file name of the certificate."
