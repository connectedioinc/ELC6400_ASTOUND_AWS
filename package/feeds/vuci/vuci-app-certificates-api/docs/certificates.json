      "200CertGet": {
        "description": "Returns generated and generating certificates.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "generated": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/cert_options"
                      }
                    },
                    "generating": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["key", "cert", "dh"],
                            "description": "File type"
                          },
                          "fullname": {
