      "devman_dm_group_id_opt": {
        "type": "object",
        "properties": {
          "dm_group_id": {
            "type": "string",
            "description": "Group's ID for which this configuration will be applied to. Either 'dm_group_id' or 'dm_device_id' must be present (but not together).",
