                        ]
                      },
                      {
                        "$ref": "#/components/schemas/devman_switch_port"
                      }
                    ]
                  }
                }
              },
              "required": [
                "success",
                "data"
              ]
            }
          }
        }
      }
    },
    "requestBodies": {
      "req_body_siteman_switch_ports_one": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/devman_switch_port"
