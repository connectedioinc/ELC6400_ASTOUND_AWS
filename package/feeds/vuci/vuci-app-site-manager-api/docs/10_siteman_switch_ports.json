                        }
                      },
                      "required": [
                        "id"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/devman_switch_port"
                    }
                  ]
                }
              },
              "required": [
                "success",
                "data"
              ]
            }
          }
        }
