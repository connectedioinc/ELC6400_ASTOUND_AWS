  "components": {
    "schemas": {
      "devman_switch_port": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "dm_device_id": {
                "type": "string",
                "description": "Device's ID for which this configuration will be applied to.",
                "readOnly": true
              }
            },
            "required": [
              "dm_device_id"
            ]
          },
          {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "string",
                "description": "Enable/Disable port.",
                "enum": [
                  "0",
                  "1"
                ],
                "x-web": {
                  "pretty": "Enable",
                  "input-type": "switch"
                }
              },
              "speed": {
                "type": "string",
                "description": "Port speed.",
                "enum": [
                  "auto",
                  "10",
                  "100",
                  "1000"
                ],
                "x-web": {
                  "pretty": "Speed",
                  "input-type": "select",
                  "enum-pretty": {
                    "auto": "Auto",
                    "10": "10 Mbps",
                    "100": "100 Mbps",
                    "1000": "1000 Mbps"
                  }
                }
              },
              "duplex": {
                "type": "string",
                "description": "Duplex mode.",
                "enum": [
                  "full",
                  "half"
                ],
                "x-web": {
                  "pretty": "Duplex",
                  "input-type": "select",
                  "enum-pretty": {
                    "full": "Full",
                    "half": "Half"
                  }
                }
              },
              "isolated": {
                "type": "string",
                "description": "Port isolation.",
                "enum": [
                  "0",
                  "1"
                ],
                "x-web": {
                  "pretty": "Isolated",
                  "input-type": "switch"
                }
              },
              "description": {
                "type": "string",
                "description": "Port description.",
                "x-web": {
                  "pretty": "Description",
                  "input-type": "input"
                }
              },
              "_id": {
                "type": "string",
                "description": "Port ID.",
                "readOnly": true
              },
              "poe_enable": {
                "type": "string",
                "description": "Enable/Disable PoE.",
                "enum": [
                  "0",
                  "1"
                ],
                "x-web": {
                  "pretty": "PoE",
                  "input-type": "switch"
                }
              },
              "eee_enable": {
                "type": "string",
                "description": "Enable/Disable EEE (Energy Efficient Ethernet).",
                "enum": [
                  "0",
                  "1"
                ],
                "x-web": {
                  "pretty": "EEE",
                  "input-type": "switch"
                }
              }
            }
          }
        ]
      }
    },
    "responses": {
      "200_siteman_switch_ports_one": {
        "description": "",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
