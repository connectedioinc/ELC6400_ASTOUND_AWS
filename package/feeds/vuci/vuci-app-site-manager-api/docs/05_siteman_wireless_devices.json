          "use_global_settings": {
            "type": "string",
            "description": "Use global settings. If enabled, the device will use global settings.",
            "format": "is_bool",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
              "pretty": "Use global settings",
              "group": "General Setup",
              "input-type": "switch"
            }
          },
          "txpower": {
            "type": "string",
            "description": "Transmit Power. The transmit power of an access point radio is proportional to its effective range – the higher the transmit power, the farther the signal can travel and/or the more physical materials it can effectively penetrate and still have data successfully resolved data at the receiver. Available values can be checked in the wireless devices status_full endpoint (options.txpwrlist.dbm values).",
            "x-web": {
              "pretty": "Transmit Power",
              "group": "General Setup",
              "input-type": "select",
              "enum-pretty": {
                "12.5": "12.5%",
                "25": "25%",
                "37.5": "37.5%",
                "50": "50%",
                "62.5": "62.5%",
                "75": "75%",
                "87.5": "87.5%",
                "100": "100%"
              }
            }
          },
          "legacy_rates": {
            "type": "string",
            "description": "Allow legacy 802.11b rates. Choose either to allow or not connections that uses legacy 802.11b standard",
            "enum": [
              "0",
              "1"
            ],
            "default": "1",
            "x-web": {
              "pretty": "Allow legacy 802.11b rates",
              "group": "Advanced Settings",
              "input-type": "switch"
            }
          },
          "distance": {
            "type": "string",
            "description": "Distance Optimization. Distance to farthest network member in meters.",
            "x-web": {
              "pretty": "Distance Optimization",
              "group": "Advanced Settings",
              "input-type": "input"
            }
          },
          "frag": {
            "type": "string",
            "description": "Fragmentation Threshold. The smallest packet size that can be fragmented and transmitted by multiple frames. In areas where interference is a problem, setting a lower fragment threshold might help reduce the probability of unsuccessful packet transfers and increase speed",
            "x-web": {
              "pretty": "Fragmentation Threshold",
              "group": "Advanced Settings",
              "input-type": "input"
            }
          },
          "rts": {
            "type": "string",
            "description": "RTS/CTS Threshold. RTS/CTS (Request to Send/Clear to Send) are mechanisms used to reduce frame collisions introduced by the hidden node problem. It can help resolve problems that arise when several access points are in the same area and contend with each other",
            "x-web": {
              "pretty": "RTS/CTS Threshold",
              "group": "Advanced Settings",
              "input-type": "input"
            }
          },
          "noscan": {
            "type": "string",
            "description": "Force 40MHz mode. Always use 40MHz channels even if the secondary channel overlaps. Using this option does not comply with IEEE 802.11n",
            "enum": [
              "0",
              "1"
            ],
            "x-web": {
