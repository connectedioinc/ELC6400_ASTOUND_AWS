{
  "openapi": "3.0.0",
  "tags": [
    {
      "name": "OPC UA Client Global Settings"
    }
  ],
  "paths": {
    "/opcua/global": {
      "get": {
        "tags": [
          "Client Global Settings"
        ],
        "summary": "Returns all OPC UA Client Global Settings configurations",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200opcuaGlobal"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "tags": [
          "Client Global Settings"
        ],
        "summary": "Updates specified OPC UA Client Global Settings configurations",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200opcuaGlobal"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/opcua_global_single_options"
                  }
                }
              }
            }
          }
        }
      },
      "x-web": {
        "name": "OPC UA",
        "menu": [
          "Services",
          "OPC UA",
          "Client"
        ],
        "hw_tags": {
          "is_access_point": false,
          "is_switch": false
        }
      }
    },
    "/opcua/database/entries/status": {
      "get": {
        "tags": [
          "Client Global Settings"
        ],
        "summary": "Returns all OPC UA Client database entries",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200OPCUADatabaseEntries"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Limit number of items returned"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Number of items to skip from the beginning"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by ID"
          },
          {
            "name": "group_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by group name"
          },
          {
            "name": "group_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by group ID"
          }
        ]
      },
      "x-web": {
        "name": "OPC UA",
        "menu": [
          "Services",
          "OPC UA",
          "Client"
        ],
        "hw_tags": {
          "is_access_point": false,
          "is_switch": false
        }
      }
    },
