  "components": {
    "responses": {
      "200RiIn": {
        "description": "Returns section",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/rip_interface_options_multi"
                }
              }
            }
          }
        }
      },
      "200RiInMulti": {
        "description": "Returns sections",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/rip_interface_options_multi"
                  }
                }
              }
            }
          }
        }
      },
      "rip_available_interfaces": {
        "description": "Lists available interfaces for selection",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "object",
                  "description": "list of available interfaces",
                  "properties": {
                    "available_interfaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "parent": {
                            "type": "string",
                            "description": "Parent to which this interface belongs"
                          },
                          "ifname": {
                            "type": "string",
                            "description": "Interface name"
                          },
                          "service": {
                            "type": "string",
                            "description": "Service this interface belongs to"
                          },
                          "interfaces": {
                            "type": "string",
                            "description": "Logical interfaces to which the interface is assigned"
                          },
                          "ports": {
                            "type": "string",
                            "description": "Physical interfaces assigned to the bridge"
                          },
                          "child": {
                            "type": "string",
                            "description": "Child instance name"
                          }
                        },
                        "required": ["ifname"]
                      }
                    }
                  }
                }
              },
              "required": ["success", "data"]
            }
          }
        }
      }
    },
    "schemas": {
      "rip_interface_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "x-web": {
              "pretty": "Enabled",
              "input-type": "switch"
            },
            "type": "string"
          },
          "ifname": {
            "x-web": {
              "pretty": "Interface",
              "input-type": "input"
            },
            "type": "string",
            "description": "Interface name."
          },
          "passive_interface": {
            "x-web": {
              "pretty": "Passive Interface",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Specify interface to passive mode."
          }
        }
      },
      "rip_interface_options_multi": {
        "title": "rip_interface_options_multi",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "x-web": {
                  "pretty": "Configuration name",
                  "unique": true,
                  "input-type": "input"
                },
                "type": "string"
              }
            }
          },
          {
            "$ref": "#/components/schemas/rip_interface_options"
          }
        ]
      }
    }
  },
  "info": {
    "title": "RIP Interfaces",
    "version": "1.0",
    "description": "RIP interfaces api documentation"
  },
  "tags": [
