{
  "openapi": "3.0.0",
  "paths": {
    "/zerotier/{id}/networks/config": {
      "post": {
        "summary": "Creates Zerotier Network configuration",
        "responses": {
          "201": {
            "$ref": "#/components/responses/200ZerotierNetwork"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/zerotier_network_single_options"
                  }
                }
              }
            }
          }
        },
        "tags": ["Networks"]
      },
      "put": {
        "summary": "Updates specified Zerotier Network configurations",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200ZerotierNetworkMulti"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "description": "Array of configuration objects",
                    "items": {
                      "$ref": "#/components/schemas/zerotier_network_options"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Networks"]
      },
      "get": {
        "summary": "Returns all Zerotier Network configurations",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200ZerotierNetworkMulti"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "tags": ["Networks"],
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "delete": {
        "summary": "Deletes specified Zerotier network configurations",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200deleted_multi"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "description": "Array of section objects",
                    "items": {
                      "type": "string",
                      "description": "Section id"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Networks"]
      },
      "x-web": {
        "menu": ["Services", "VPN", "ZeroTier"],
        "hw_tags": {
          "is_switch": false,
          "is_access_point": false
        },
        "name": "ZeroTier"
      },
      "parameters": [
        {
          "schema": {
            "type": "string"
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Zerotier Configuration identifier (ID)"
        }
      ]
    },
    "/zerotier/{id}/networks/config/{networks_id}": {
      "post": {
        "tags": ["General"],
        "summary": "Uploads planet file for the specified Zerotier Network configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/file_response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Zerotier network configuration identifier (ID)"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "option": {
                    "type": "string",
                    "description": "Parameter to upload the file to.",
                    "enum": ["custom_planet_file"]
                  },
                  "file": {
                    "type": "string",
                    "description": "File to upload.",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Updates the specified Zerotier Network configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200ZerotierNetwork"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "description": "Parameter section",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/zerotier_network_single_options"
                  }
                }
              }
            }
          }
        },
        "tags": ["Networks"]
      },
      "get": {
        "summary": "Returns the specified Zerotier Network configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200ZerotierNetwork"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "tags": ["Networks"],
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "delete": {
        "summary": "Deletes the specified Zerotier Network configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200deleted"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "tags": ["Networks"]
      },
      "x-web": {
        "menu": ["Services", "VPN", "ZeroTier"],
        "hw_tags": {
          "is_switch": false,
          "is_access_point": false
        },
        "name": "ZeroTier"
      },
      "parameters": [
        {
          "schema": {
            "type": "string"
          },
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Zerotier Configuration identifier (ID)"
        },
        {
          "schema": {
            "type": "string"
          },
          "name": "networks_id",
          "in": "path",
          "required": true,
          "description": "Zerotier Network Configuration identifier (ID)"
        }
      ]
    }
  },
  "components": {
    "responses": {
      "200ZerotierNetwork": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/zerotier_network_options"
                }
              }
            }
          }
        }
      },
      "200ZerotierNetworkMulti": {
        "description": "Returns configurations",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/zerotier_network_options"
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "zerotier_network_single_options": {
        "type": "object",
        "properties": {
          "enabled": {
            "x-web": {
              "pretty": "Enable",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Turn this zerotier network on/off",
            "format": "is_bool"
          },
          "name": {
            "x-web": {
              "pretty": "Network name",
              "input-type": "input"
            },
            "type": "string",
            "description": "Name of the Zerotier network",
            "maxLength": 32,
            "format": "uciname"
          },
          "port": {
            "x-web": {
              "pretty": "Port",
              "input-type": "input"
            },
            "type": "string",
            "description": "Network port for UDP and TCP/HTTP connections (default: 9993, set to 0 for random port assignment).",
            "format": "port"
          },
          "allow_default": {
            "x-web": {
              "pretty": "Allow default route",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Allows ZeroTier to override system default route",
            "format": "is_bool"
          },
          "allow_global": {
            "x-web": {
              "pretty": "Allow global IP",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Allows ZeroTier managed IPs and routes to overlap public IP space",
            "format": "is_bool"
          },
          "allow_managed": {
            "x-web": {
              "pretty": "Allow managed IP",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Assigns ZeroTier managed IPs and routes",
            "format": "is_bool"
          },
          "allow_dns": {
            "x-web": {
              "pretty": "Allow DNS",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Applies DNS servers that are set at the network controller",
            "format": "is_bool"
          },
          "network_id": {
            "x-web": {
              "pretty": "Network ID",
              "input-type": "input",
              "require-depends": [
                { "enabled": "1" }
              ]
            },
            "type": "string",
            "description": "Zerotier networks ID",
            "format": "hexstring",
            "maxLength": 16
          },
          "bridge_to": {
            "type": "string",
            "x-web": {
              "pretty": "Bridge to",
              "input-type": "input"
            },
            "description": "Specify to which interface this ZeroTier instance should be bridged"
          },
          "custom_planet_file": {
            "type": "string",
            "x-web": {
              "pretty": "Custom planet file",
              "input-type": "input",
              "upload_endpoint": "/zerotier/{id}/networks/config/{networks_id}"
            },
            "description": "Custom planet file contains user-defined roots, enabling the use of private root servers",
            "format": "binary"
          },
          "custom_planet_file:file_size": {
            "description": "Uploaded file size in bytes.",
            "type": "number",
            "readOnly": true
          }
        }
      },
      "zerotier_network_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "x-web": {
                  "pretty": "Configuration ID",
                  "input-type": "input"
                },
                "type": "string",
                "description": "Zerotier Network Configuration identifier (ID)."
              }
            },
            "required": ["id"]
          },
          {
            "$ref": "#/components/schemas/zerotier_network_single_options"
          }
        ]
      }
    }
  },
  "info": {
    "version": "1.0",
    "title": "ZeroTier Networks",
    "description": "ZeroTier Networks api documentation"
  },
  "tags": [
    {
      "name": "Networks"
    }
  ]
}
