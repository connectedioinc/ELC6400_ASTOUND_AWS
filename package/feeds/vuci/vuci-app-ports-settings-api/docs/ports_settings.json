  "components": {
    "schemas": {
      "ports_messages": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Message code; 1 = 802.1X authentication for the port was disabled"
          },
          "message": {
            "type": "string",
            "description": "Description of the message code"
          }
        }
      },
      "ports_general": {
        "title": "ports_general",
        "type": "object",
        "properties": {
          "enable_jumbo": {
            "x-web": {
              "input-type": "switch",
              "pretty": "Jumbo frames",
              "group": "Ports General"
            },
            "type": "string",
            "description": "Allow ethernet frame with a payload greater than the standard maximum transmission unit (MTU) of 1500 bytes. This may improve network performance by making data transmissions more efficient.",
            "enum": ["0", "1"]
          },
          "lldp_filter": {
            "x-web": {
              "input-type": "switch",
              "pretty": "LLDP frame filter",
              "group": "Ports General"
            },
            "type": "string",
            "description": "Enable to stop the forwarding of LLDP frames.",
            "enum": ["0", "1"]
          },
          "igmp_snooping": {
            "x-web": {
              "input-type": "switch",
              "pretty": "IGMP snooping",
              "group": "Ports General"
            },
            "type": "string",
            "description": "Enables IGMP snooping.",
            "enum": ["0", "1"]
          },
          "multicast_enable": {
            "x-web": {
              "input-type": "switch",
              "pretty": "Enable multicast",
              "group": "Ports General"
            },
            "type": "string",
            "description": "Enables multicast without IGMP snooping.",
            "enum": ["0", "1"]
          },
          "multicast_querier": {
            "x-web": {
              "input-type": "switch",
              "pretty": "Multicast querier",
              "group": "Ports General"
            },
            "type": "string",
            "description": "Enables multicast querier.",
            "enum": ["0", "1"]
          },
          "query_interval": {
            "type": "number",
            "format": "range(1,20)",
            "description": "Interval in seconds between multicast general queries. By varying the value, an administrator may tune the number of IGMP messages on the subnet; larger values cause IGMP Queries to be sent less often.",
            "x-web": {
              "pretty": "Query interval",
              "input-type": "input",
              "group": "Ports General",
              "depends": [
                {
                  "multicast_querier": "1"
                }
              ]
            }
          },
          "query_response_interval": {
            "type": "number",
            "format": "range(1,20)",
            "description": "The max response time in seconds inserted into the periodic general queries. By varying the value, an administrator may tune the burstiness of IGMP messages on the subnet; larger values make the traffic less bursty, as host responses are spread out over a larger interval.",
            "x-web": {
              "pretty": "Query response interval",
              "input-type": "input",
              "group": "Ports General",
              "depends": [
                {
                  "multicast_querier": "1"
                }
              ]
            }
          }
        }
      },
      "ports_settings": {
        "title": "ports_settings",
        "type": "object",
        "properties": {
          "enabled": {
            "x-web": {
              "input-type": "switch",
              "pretty": "Enable",
              "group": "All Ports"
            },
            "type": "string",
            "enum": ["1", "0"],
            "description": "Toggle port on or off."
          },
          "description": {
            "x-web": {
              "input-type": "input",
              "pretty": "Port name",
              "group": "All Ports",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "description": "Name of the port. This is only used for easier management purposes."
          },
          "eee_enable": {
            "x-web": {
              "input-type": "switch",
              "pretty": "EEE",
              "group": "All Ports",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "description": "Enable Energy-Efficient Ethernet.",
            "enum": ["0", "1"]
          },
          "isolated": {
            "x-web": {
              "input-type": "switch",
              "pretty": "Isolate port",
              "group": "All Ports",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "description": "When enabled port will be isolated from other isolated ports. Traffic between isolated ports will dropped. Traffic between isolated and normal ports will be sent as normal.",
            "enum": ["0", "1"]
          },
          "poe_enable": {
            "x-web": {
              "input-type": "switch",
              "pretty": "PoE",
              "group": "All Ports",
              "hw_tags": {
                "poe": true
              }
            },
            "type": "string",
            "description": "Enable Power over Ethernet.",
            "enum": ["0", "1"]
          },
          "mtu": {
            "x-web": {
              "input-type": "input",
              "pretty": "MTU",
              "group": "All Ports",
              "hw_tags": {
                "is_switch": false,
                "dsa": true
              }
            },
            "type": "string",
            "format": "irange(68,9200)",
            "description": "Sets the maximum transmission unit (MTU) size. It is the largest size of a protocol data unit (PDU) that can be transmitted in a single network layer transaction."
          },
          "autoneg": {
            "x-web": {
              "input-type": "select",
              "pretty": "Auto negotiation",
              "group": "All Ports",
              "enum-pretty": {
                "on": "On",
                "off": "Off"
              }
            },
            "type": "string",
            "enum": ["on", "off"],
            "description": "Auto negotiation allows the device to communicate with devices on the other end of the link to determine the optimal duplex mode and speed for the port."
          },
          "speed": {
            "x-web": {
              "input-type": "select",
              "pretty": "Link Speed",
              "group": "All Ports",
              "enum-pretty": {
                "": "Auto",
                "10": "10Mbps (E)",
                "100": "100Mbps (FE)"
              }
            },
            "type": "string",
            "enum": ["10", "100"],
            "description": "A measure of how fast ports are able to transmit and receive data."
          },
          "duplex": {
            "x-web": {
              "input-type": "select",
              "pretty": "Duplex",
              "group": "All Ports",
              "depends": [
                {
                  "speed": ["10", "100"]
                }
              ],
              "enum-pretty": {
                "full": "Full",
                "half": "Half"
              }
            },
            "type": "string",
            "enum": ["full", "half"],
            "description": "Bidirectional communication system that allows both end nodes to send and receive communication data or signals. Full - sends and receives simultaneously. Half - sends or receives one path at a time."
          },
          "advert": {
            "x-web": {
              "input-type": "multiselect",
              "pretty": "Advertisement",
              "group": "All Ports",
              "enum-pretty": {
                "10mh": "10M-Half",
                "10mf": "10M-Full",
                "100mh": "100M-Half",
                "100mf": "100M-Full",
                "1000mh": "1000M-Half",
                "1000mf": "1000M-Full",
                "2500mf": "2500M-Full"
              },
              "enum-depends": [
                {
                  "depends": {
                    "autoneg": "on"
                  },
                  "hw_tags": {
                    "gigabit_port": false,
                    "2_5_gigabit_port": false,
                    "is_switch": false
                  },
                  "values": ["10mh", "10mf", "100mh", "100mf"]
                },
                {
                  "depends": {
                    "autoneg": "on"
                  },
                  "hw_tags": {
                    "gigabit_port": true,
                    "2_5_gigabit_port": false,
                    "is_switch": false
                  },
                  "values": ["10mh", "10mf", "100mh", "100mf", "1000mf"]
                },
                {
                  "depends": {
                    "autoneg": "on"
                  },
                  "hw_tags": {
                    "gigabit_port": true,
                    "2_5_gigabit_port": true,
                    "is_switch": false
                  },
                  "values": ["10mh", "10mf", "100mh", "100mf", "1000mf", "2500mf"]
                },
                {
                  "depends": {
                    "autoneg": "on"
                  },
                  "hw_tags": {
                    "is_switch": true
                  },
                  "values": ["10mh", "10mf", "100mh", "100mf", "1000mh", "1000mf"]
                }
              ]
            },
            "type": "array",
            "items": {
              "type": "string"
            },
            "enum": ["10mh", "10mf", "100mh", "100mf", "1000mf", "2500mf"],
            "description": "Advertises preferred duplex mode and speed for negotiation with other devices."
          },
          "qos_pri_group": {
            "x-web": {
              "input-type": "select",
              "pretty": "Prioritization mode",
              "group": "Port Priority",
              "enum-pretty": {
                "0": "CoS",
                "1": "DSCP",
                "2": "Equal"
              },
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "enum": ["0", "1", "2"],
            "description": "Utilizes either CoS, DSCP or both markings equally. "
          },
          "qos_pri_inner": {
            "x-web": {
              "input-type": "select",
              "pretty": "Priority",
              "group": "Port Priority",
              "enum-pretty": {
                "0": "CoS-0",
                "1": "CoS-1",
                "2": "CoS-2",
                "3": "CoS-3",
                "4": "CoS-4",
                "5": "CoS-5",
                "6": "CoS-6",
                "7": "CoS-7"
              },
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "enum": ["0", "1", "2", "3", "4", "5", "6", "7"],
            "description": "Port-based priority of the specified port."
          },
          "ingr_rate": {
            "x-web": {
              "input-type": "input",
              "pretty": "Ingress bandwidth",
              "group": "Port rate limit",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "format": "irange(0, 1000000)",
            "description": "Ingress bandwidth in Kbps units."
          },
          "egr_rate": {
            "x-web": {
              "input-type": "input",
              "pretty": "Egress bandwidth",
              "group": "Port rate limit",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "format": "irange(0, 1000000)",
            "description": "Egress bandwidth in Kbps units."
          },
          "storm_mult_rate": {
            "x-web": {
              "input-type": "input",
              "pretty": "Multicast rate",
              "group": "Port storm control",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "format": "irange(0, 1000000)",
            "description": "Multicast Storm Filtering Control Rate In Kbps units."
          },
          "storm_broad_rate": {
            "x-web": {
              "input-type": "input",
              "pretty": "Broadcast rate",
              "group": "Port storm control",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "format": "irange(0, 1000000)",
            "description": "Broadcast Storm Filtering Control Rate In Kbps units."
          },
          "storm_uni_rate": {
            "x-web": {
              "input-type": "input",
              "pretty": "Unicast rate",
              "group": "Port storm control",
              "hw_tags": {
                "is_switch": true
              }
            },
            "type": "string",
            "format": "irange(0, 1000000)",
            "description": "Unicast Storm Filtering Control Rate In Kbps units."
          },
          "stp_edge": {
            "type": "string",
            "description": "Whether to treat port as an edge port when STP is enabled",
            "enum": ["0", "1"],
            "x-web": {
              "pretty": "STP edge",
              "input-type": "switch",
              "hw_tags": {
                "is_switch": true
              }
            }
          }
        }
      },
