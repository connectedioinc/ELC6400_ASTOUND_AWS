        "description": "",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "ports": {
                        "type": "array",
                        "description": "List of ports to restart the link for.",
                        "items": {
                          "type": "string"
                        },
                        "x-web": {
                          "input-type": "input",
                          "pretty": "Ports"
                        }
                      },
                      "interval": {
                        "type": "number",
                        "description": "Interval in seconds between link disable and enable.",
                        "default": 3,
                        "format": "irange(3,15)",
