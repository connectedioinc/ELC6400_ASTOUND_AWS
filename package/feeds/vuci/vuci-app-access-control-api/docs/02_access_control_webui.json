  "paths": {
    "/access_control/webui/status": {
      "get": {
        "summary": "Returns all Access Control statuses",
        "tags": ["WebUI"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "string",
                      "description": "Operation status."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "HTTP": {
                          "type": "object",
                          "properties": {
                            "lan": {
                              "type": "boolean",
                              "description": "HTTP on LAN is enabled/disabled."
                            },
                            "wan": {
                              "type": "boolean",
                              "description": "HTTP on WAN is enabled/disabled.",
                              "x-web": {
                                "pretty": "WAN",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            },
                            "port": {
                              "description": "HTTP port.",
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ]
                            },
                            "wan_port": {
                              "description": "WAN HTTP port.",
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ],
                              "x-web": {
                                "pretty": "WAN HTTP Port",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            }
                          }
                        },
                        "HTTPS": {
                          "type": "object",
                          "properties": {
                            "lan": {
                              "type": "boolean",
                              "description": "HTTPS on LAN is enabled/disabled."
                            },
                            "wan": {
                              "type": "boolean",
                              "description": "HTTPS on WAN is enabled/disabled.",
                              "x-web": {
                                "pretty": "WAN",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            },
                            "port": {
                              "description": "HTTPS port.",
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ]
                            },
                            "wan_port": {
                              "description": "WAN HTTPS port.",
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              ],
                              "x-web": {
                                "pretty": "WAN HTTS Port",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            }
                          }
                        },
                        "SSH": {
                          "type": "object",
                          "properties": {
                            "lan": {
                              "type": "boolean",
                              "description": "SSH on LAN is enabled/disabled."
                            },
                            "wan": {
                              "type": "boolean",
                              "description": "SSH on WAN is enabled/disabled.",
                              "x-web": {
                                "pretty": "WAN",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            },
                            "port": {
                              "description": "SSH port.",
                              "type": "string"
                            },
                            "wan_port": {
                              "description": "WAN SSH port.",
                              "type": "string",
                              "x-web": {
                                "pretty": "WAN SSH port",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            }
                          }
                        },
                        "CLI": {
                          "type": "object",
                          "properties": {
                            "lan": {
                              "type": "boolean",
                              "description": "CLI on LAN is enabled/disabled."
                            },
                            "wan": {
                              "type": "boolean",
                              "description": "CLI on WAN is enabled/disabled.",
                              "x-web": {
                                "pretty": "WAN",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            },
                            "port": {
                              "description": "CLI port.",
                              "type": "string"
                            },
                            "wan_port": {
                              "description": "WAN CLI port.",
                              "type": "string",
                              "x-web": {
                                "pretty": "WAN CLI port",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            }
                          }
                        },
                        "Telnet": {
                          "type": "object",
                          "properties": {
                            "lan": {
                              "type": "boolean",
                              "description": "Telnet on LAN is enabled/disabled."
                            },
                            "wan": {
                              "type": "boolean",
                              "description": "Telnet on WAN is enabled/disabled.",
                              "x-web": {
                                "pretty": "WAN",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            },
                            "port": {
                              "description": "Telnet port.",
                              "type": "string"
                            },
                            "wan_port": {
                              "description": "WAN Telnet port.",
                              "type": "string",
                              "x-web": {
                                "pretty": "WAN Telnet port",
                                "hw_tags": {
                                  "is_access_point": false,
                                  "is_switch": false
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "x-web": {
        "menu": ["System", "Administration", "Access Control", "General"]
      }
    },
    "/access_control/webui/certificate/status": {
      "get": {
        "summary": "Returns information about HTTPS certificate",
        "tags": ["WebUI"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "string",
                      "description": "Operation status."
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cert": {
                            "type": "string",
                            "description": "Certificate file path."
                          },
                          "expires": {
                            "type": "string",
                            "description": "Certificate expiration timestamp."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        }
      },
      "x-web": {
        "menu": ["System", "Administration", "Access Control", "General"]
      }
    },
    "/access_control/webui/config": {
      "get": {
        "summary": "Returns WebUI configuration",
        "tags": ["WebUI"],
        "responses": {
          "200": {
            "$ref": "#/components/responses/200AccessControlWebUI"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "summary": "Updates WebUI configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200AccessControlWebUI"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "$ref": "#/components/requestBodies/webui_request"
        },
        "tags": ["WebUI"]
      },
      "x-web": {
        "menu": ["System", "Administration", "Access Control", "General"]
      }
    },
    "/access_control/webui/config/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Configuration ID"
        }
      ],
      "post": {
        "summary": "Uploads certificate or private key file",
        "responses": {
          "200": {
            "$ref": "#/components/responses/file_response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Configuration ID"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/file_upload_ac_webui"
        },
        "x-web": {
          "hw_tags": {
            "is_access_point": false,
            "is_switch": false
          }
        },
        "tags": ["WebUI"]
      },
      "get": {
        "summary": "Returns WebUI configuration",
        "tags": ["WebUI"],
        "responses": {
          "200": {
            "$ref": "#/components/responses/200AccessControlWebUISingle"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/all_options"
          }
        ]
      },
      "put": {
        "summary": "Updates WebUI configuration",
        "responses": {
          "200": {
            "$ref": "#/components/responses/200AccessControlWebUISingle"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "$ref": "#/components/requestBodies/webui_request_single"
        },
        "tags": ["WebUI"]
      },
      "x-web": {
        "menu": ["System", "Administration", "Access Control", "General"]
      }
    },
    "/access_control/webui/actions/download": {
      "post": {
        "summary": "Downloads default certificate authority file",
        "tags": ["WebUI"],
        "responses": {
          "200": {
            "$ref": "#/components/responses/file_download"
          },
          "404": {
            "$ref": "#/components/responses/404response"
          }
        }
      },
      "x-web": {
        "menu": ["System", "Administration", "Access Control", "General"]
      }
    },
    "/access_control/webui/actions/generate": {
      "post": {
        "summary": "Re-generate default self-signed HTTPS certificate",
        "tags": ["WebUI"],
        "responses": {
          "200": {
            "$ref": "#/components/responses/200response"
          },
          "422": {
            "$ref": "#/components/responses/422response"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "description": "",
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "force": {
                        "type": "string",
                        "description": "Force CA certificate regeneration.",
                        "format": "is_bool",
                        "enum": ["0", "1"]
                      },
                      "replace": {
                        "type": "string",
                        "description": "Replace uhttpd certificates with newly generated ones.",
                        "format": "is_bool",
                        "enum": ["0", "1"]
                      }
                    }
                  }
                },
                "required": ["data"]
              }
            }
          }
        }
      },
      "x-web": {
        "menu": ["System", "Administration", "Access Control", "General"]
      }
    }
  },
  "components": {
    "responses": {
      "200AccessControlWebUI": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "x-examples": {
                "example-1": {
                  "success": true,
                  "messages": [
                    {
                      "message": "It's recommended to use a minimum RSA key length of 2048 bits for the certificate.",
                      "source": "general:cert",
                      "code": 1
                    }
                  ],
                  "data": [
                    {
                      "key:file_size": 891,
                      ".type": "uhttpd",
                      "id": "general",
                      "listen_https": "443",
                      "enable_http": "1",
                      "cert": "/etc/vuci-uploads/cbid.uhttpd.general.certcertificate.pem",
                      "key": "/etc/vuci-uploads/cbid.uhttpd.general.keyprivate_key.pem",
                      "cert:file_size": 761,
                      "enable_https": "1",
                      "rfc1918_filter": "1",
                      "device_files": "0",
                      "listen_http": "80",
                      "redirect_https": "0",
                      "http_wan_access": "0",
                      "https_wan_access": "0"
                    }
                  ]
                }
              },
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/access_control_webui_options_response"
                  }
                }
              }
            }
          }
        }
      },
      "200AccessControlWebUISingle": {
        "description": "Returns configuration",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Operation status"
                },
                "data": {
                  "$ref": "#/components/schemas/access_control_webui_options_response"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "access_control_webui_options_response": {
        "allOf": [
          {
            "$ref": "#/components/schemas/access_control_webui_options"
          },
          {
            "type": "object",
            "properties": {
              "key:file_size": {
                "type": "string",
                "description": "Uploaded certificate key file size",
                "x-web": {
                  "pretty": "Server key size",
                  "hw_tags": {
                    "is_access_point": false,
                    "is_switch": false
                  }
                }
              },
              "cert:file_size": {
                "type": "string",
                "description": "Uploaded certificate file size",
                "x-web": {
                  "pretty": "Server certificate size",
                  "hw_tags": {
                    "is_access_point": false,
                    "is_switch": false
                  }
                }
              }
            }
          }
        ]
      },
      "access_control_webui_options": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Configuration ID"
              }
            }
          },
          {
            "$ref": "#/components/schemas/access_control_webui_single_options"
          }
        ]
      },
      "access_control_webui_single_options": {
        "type": "object",
        "properties": {
          "enable_http": {
            "x-web": {
              "pretty": "Enable HTTP access",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Turns HTTP access from the local network (LAN) to the router's WebUI on or off.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "enable_https": {
            "x-web": {
              "pretty": "Enable HTTPS access",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Turns HTTPS access from the local network (LAN) to the router's WebUI on or off.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "redirect_https": {
            "x-web": {
              "pretty": "Redirect to HTTPS",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Redirects connection attempts from HTTP to HTTPS.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "http_wan_access": {
            "x-web": {
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              },
              "pretty": "Enable remote HTTP access",
              "input-type": "switch",
              "depends": [
                {
                  "enable_http": "1"
                }
              ]
            },
            "type": "string",
            "description": "Turns HTTP access from remote networks (WAN) to the router's WebUI on or off.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "listen_http": {
            "x-web": {
              "pretty": "HTTP Port",
              "input-type": "input",
              "depends": [
                {
                  "enable_http": "1"
                }
              ]
            },
            "description": "Selects which port to use for HTTP access.",
            "oneOf": [
              {
                "type": "string",
                "format": "port"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "port"
                }
              }
            ]
          },
          "wan_listen_http": {
            "x-web": {
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              },
              "pretty": "HTTP WAN Port",
              "input-type": "input",
              "depends": [
                {
                  "enable_http": "1"
                }
              ]
            },
            "description": "Selects which port to use for HTTP WAN access.",
            "oneOf": [
              {
                "type": "string",
                "format": "port"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "port"
                }
              }
            ]
          },
          "https_wan_access": {
            "x-web": {
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              },
              "pretty": "Enable remote HTTPS access",
              "input-type": "switch",
              "depends": [
                {
                  "enable_https": "1"
                }
              ]
            },
            "type": "string",
            "description": "Turns HTTPS access from remote networks (WAN) to the router's WebUI on or off.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "listen_https": {
            "x-web": {
              "pretty": "HTTPS Port",
              "input-type": "input",
              "depends": [
                {
                  "enable_https": "1"
                }
              ]
            },
            "description": "Selects which port to use for HTTPS access.",
            "oneOf": [
              {
                "type": "string",
                "format": "port"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "port"
                }
              }
            ]
          },
          "wan_listen_https": {
            "x-web": {
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              },
              "pretty": "HTTPS WAN Port",
              "input-type": "input",
              "depends": [
                {
                  "enable_http": "1"
                }
              ]
            },
            "description": "Selects which port to use for HTTPS WAN access.",
            "oneOf": [
              {
                "type": "string",
                "format": "port"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "port"
                }
              }
            ]
          },
          "enable_json_rpc": {
            "x-web": {
              "pretty": "Enable JSON-RPC",
              "input-type": "switch"
            },
            "type": "string",
            "description": "Turns JSON-RPC access on or off.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "rfc1918_filter_http": {
            "x-web": {
              "pretty": "Ignore private IPs on public interface for HTTP",
              "input-type": "switch",
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              }
            },
            "type": "string",
            "description": "Prevent HTTP access from private (RFC1918) IPs on an interface if it has an public IP address.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "rfc1918_filter_https": {
            "x-web": {
              "pretty": "Ignore private IPs on public interface for HTTPS",
              "input-type": "switch",
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              }
            },
            "type": "string",
            "description": "Prevent HTTPS access from private (RFC1918) IPs on an interface if it has an public IP address.",
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "rfc1918_filter": {
            "x-web": {
              "pretty": "Ignore private IPs on public interface",
              "input-type": "switch",
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              }
            },
            "type": "string",
            "description": "Prevent access from private (RFC1918) IPs on an interface if it has an public IP address.",
            "deprecated": true,
            "format": "is_bool",
            "enum": ["0", "1"]
          },
          "device_files": {
            "type": "string",
            "description": "Choose this option if you want to select certificate files from device.",
            "format": "is_bool",
            "enum": ["0", "1"],
            "x-web": {
              "pretty": "Certificate files from device",
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              }
            }
          },
          "cert": {
            "x-web": {
              "upload_endpoint": "/access_control/webui/config/{id}",
              "pretty": "Server certificate",
              "input-type": "input",
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              }
            },
            "type": "string",
            "format": "path",
            "pattern": "^/etc/(vuci-uploads|certificates)/",
            "description": "Server certificate."
          },
          "key": {
            "x-web": {
              "upload_endpoint": "/access_control/webui/config/{id}",
              "pretty": "Server key",
              "input-type": "input",
              "hw_tags": {
                "is_access_point": false,
                "is_switch": false
              }
            },
            "type": "string",
            "format": "path",
            "pattern": "^/etc/(vuci-uploads|certificates)/",
            "description": "Server key"
          },
          "enable_basic_auth": {
            "x-web": {
              "pretty": "Enable Basic Auth",
              "input-type": "input",
              "depends": [
                {
                  "enable_https": "1",
                  "redirect_https": "1"
                }
              ]
            },
            "type": "string",
            "description": "Turns Basic Auth access on or off.",
            "format": "is_bool",
            "enum": ["0", "1"]
          }
        }
      }
    },
    "requestBodies": {
      "webui_request": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "description": "Array of section objects",
                  "items": {
                    "$ref": "#/components/schemas/access_control_webui_options"
                  }
                }
              },
              "required": ["data"]
            }
          }
        }
      },
      "webui_request_single": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/access_control_webui_single_options"
                }
              },
              "required": ["data"]
            }
          }
        }
      },
      "file_upload_ac_webui": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "option": {
                  "type": "string",
                  "description": "Parameter to upload the file to.",
                  "enum": ["cert", "key"]
                },
                "file": {
                  "type": "string",
                  "format": "binary",
                  "description": "File to upload."
                }
              },
              "required": ["option", "file"]
            }
          }
        }
      }
    }
  }
}
